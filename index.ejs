<!DOCTYPE html>
<html lang="en" data-theme="<%= theme === 'auto' ? 'cosmic' : theme %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cosmic Launcher</title>
  <link rel="icon" type="image/png" href="<%= assetRoot %>app/assets/logo.png">
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Mono:wght@400;700&display=swap"
    rel="stylesheet">
  <style>
    :root,
    [data-theme="cosmic"] {
      --bg: #04040d;
      --panel: rgba(255, 255, 255, 0.03);
      --border: rgba(255, 255, 255, 0.07);
      --accent: #e8622a;
      --accent2: #f0a842;
      --text: #f0ece4;
      --muted: #6b6860;
      --glow: rgba(232, 98, 42, 0.35);
      --chrome: rgba(4, 4, 13, 0.88);
      --player-glow: rgba(232, 98, 42, 0.22);
      --nebula-warm: 22;
      --nebula-cool: 260;
    }

    [data-theme="nebula"] {
      --bg: #06040f;
      --panel: rgba(255, 255, 255, 0.03);
      --border: rgba(255, 255, 255, 0.08);
      --accent: #8b5cf6;
      --accent2: #c4b5fd;
      --text: #ede9fe;
      --muted: #7c7894;
      --glow: rgba(139, 92, 246, 0.35);
      --chrome: rgba(6, 4, 15, 0.9);
      --player-glow: rgba(139, 92, 246, 0.24);
      --nebula-warm: 280;
      --nebula-cool: 230;
    }

    [data-theme="emerald"] {
      --bg: #031208;
      --panel: rgba(255, 255, 255, 0.03);
      --border: rgba(255, 255, 255, 0.07);
      --accent: #22c55e;
      --accent2: #86efac;
      --text: #ecfdf5;
      --muted: #6b8a72;
      --glow: rgba(34, 197, 94, 0.32);
      --chrome: rgba(3, 18, 8, 0.9);
      --player-glow: rgba(34, 197, 94, 0.22);
      --nebula-warm: 130;
      --nebula-cool: 170;
    }

    [data-theme="crimson"] {
      --bg: #0d0406;
      --panel: rgba(255, 255, 255, 0.03);
      --border: rgba(255, 255, 255, 0.07);
      --accent: #ef4444;
      --accent2: #fca5a5;
      --text: #fef2f2;
      --muted: #8a6b6b;
      --glow: rgba(239, 68, 68, 0.34);
      --chrome: rgba(13, 4, 6, 0.9);
      --player-glow: rgba(239, 68, 68, 0.22);
      --nebula-warm: 0;
      --nebula-cool: 340;
    }

    [data-theme="ocean"] {
      --bg: #020810;
      --panel: rgba(255, 255, 255, 0.03);
      --border: rgba(255, 255, 255, 0.08);
      --accent: #06b6d4;
      --accent2: #67e8f9;
      --text: #ecfeff;
      --muted: #5f7f88;
      --glow: rgba(6, 182, 212, 0.34);
      --chrome: rgba(2, 8, 16, 0.9);
      --player-glow: rgba(6, 182, 212, 0.22);
      --nebula-warm: 190;
      --nebula-cool: 210;
    }

    [data-theme="sunset"] {
      --bg: #0f0608;
      --panel: rgba(255, 255, 255, 0.03);
      --border: rgba(255, 255, 255, 0.07);
      --accent: #f472b6;
      --accent2: #fdba74;
      --text: #fff1f2;
      --muted: #8a7078;
      --glow: rgba(244, 114, 182, 0.34);
      --chrome: rgba(15, 6, 8, 0.9);
      --player-glow: rgba(244, 114, 182, 0.22);
      --nebula-warm: 330;
      --nebula-cool: 20;
    }

    [data-theme="frost"] {
      --bg: #0a1018;
      --panel: rgba(255, 255, 255, 0.04);
      --border: rgba(255, 255, 255, 0.1);
      --accent: #94a3b8;
      --accent2: #e2e8f0;
      --text: #f8fafc;
      --muted: #7b8798;
      --glow: rgba(148, 163, 184, 0.28);
      --chrome: rgba(10, 16, 24, 0.92);
      --player-glow: rgba(148, 163, 184, 0.2);
      --nebula-warm: 210;
      --nebula-cool: 220;
    }

    [data-theme="gold"] {
      --bg: #0a0804;
      --panel: rgba(255, 255, 255, 0.03);
      --border: rgba(255, 255, 255, 0.07);
      --accent: #d4a017;
      --accent2: #fde047;
      --text: #fefce8;
      --muted: #8a8268;
      --glow: rgba(212, 160, 23, 0.34);
      --chrome: rgba(10, 8, 4, 0.9);
      --player-glow: rgba(212, 160, 23, 0.22);
      --nebula-warm: 45;
      --nebula-cool: 35;
    }

    [data-theme="lavender"] {
      --bg: #080612;
      --panel: rgba(255, 255, 255, 0.03);
      --border: rgba(255, 255, 255, 0.08);
      --accent: #a78bfa;
      --accent2: #ddd6fe;
      --text: #f5f3ff;
      --muted: #7f7a96;
      --glow: rgba(167, 139, 250, 0.34);
      --chrome: rgba(8, 6, 18, 0.9);
      --player-glow: rgba(167, 139, 250, 0.22);
      --nebula-warm: 270;
      --nebula-cool: 300;
    }

    [data-theme="midnight"] {
      --bg: #020308;
      --panel: rgba(255, 255, 255, 0.025);
      --border: rgba(255, 255, 255, 0.06);
      --accent: #64748b;
      --accent2: #94a3b8;
      --text: #e2e8f0;
      --muted: #5c6474;
      --glow: rgba(100, 116, 139, 0.3);
      --chrome: rgba(2, 3, 8, 0.92);
      --player-glow: rgba(100, 116, 139, 0.18);
      --nebula-warm: 215;
      --nebula-cool: 240;
    }

    html[data-theme] {
      --accent-hover: color-mix(in srgb, var(--accent) 78%, white 22%);
      --glow-strong: color-mix(in srgb, var(--accent) 52%, transparent);
      --glow-pulse-start: color-mix(in srgb, var(--accent) 80%, transparent);
      --glow-pulse-mid: color-mix(in srgb, var(--accent) 90%, transparent);
      --glow-pulse-outer: color-mix(in srgb, var(--accent2) 40%, transparent);
      --btn-radius: 7px;
      --btn-fill: rgba(255, 255, 255, 0.1);
      --btn-fill-hover: rgba(255, 255, 255, 0.16);
      --btn-border: rgba(255, 255, 255, 0.14);
      --btn-border-hover: rgba(255, 255, 255, 0.24);
    }

    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Syne', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
      width: 100vw;
      height: 100vh;
      cursor: default;
      user-select: none;
    }

    body.booting .titlebar,
    body.booting .layout,
    body.booting .panel-actions,
    body.booting .particles-canvas,
    body.booting .onboard-overlay {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    body.needs-onboarding .layout,
    body.needs-onboarding .panel-actions,
    body.needs-onboarding .particles-canvas {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    #nebula {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0.55;
    }

    .grain {
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.07'/%3E%3C/svg%3E");
      background-repeat: repeat;
      background-size: 180px 180px;
      pointer-events: none;
      z-index: 1;
    }

    .titlebar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 52px;
      display: flex;
      align-items: stretch;
      justify-content: space-between;
      padding: 0 0 0 16px;
      -webkit-app-region: drag;
      z-index: 100;
      border-bottom: 1px solid var(--border);
      background: var(--chrome);
      backdrop-filter: blur(16px);
      gap: 12px;
    }

    .tb-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
      min-width: 0;
      align-self: center;
      padding-right: 12px;
    }

    .tb-logo {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      object-fit: cover;
      flex-shrink: 0;
    }

    .tb-name {
      font-family: 'Syne', sans-serif;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--text);
      white-space: nowrap;
    }

    .tb-drag-spacer {
      flex: 1;
      min-width: 24px;
      height: 100%;
      align-self: stretch;
    }

    .tb-actions {
      display: flex;
      align-items: stretch;
      -webkit-app-region: no-drag;
      flex-shrink: 0;
      height: 100%;
    }

    .tb-control-group {
      display: flex;
      align-items: stretch;
      height: 100%;
    }

    .tb-seg-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 100%;
      padding: 0 14px;
      background: transparent;
      border: none;
      border-left: 1px solid var(--border);
      color: var(--text);
      font-family: 'Syne', sans-serif;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      white-space: nowrap;
      -webkit-app-region: no-drag;
    }

    .tb-control-group > :first-child .tb-seg-btn,
    .tb-control-group > .tb-seg-btn:first-child,
    .panel-control-group > :first-child .tb-seg-btn,
    .panel-control-group > .tb-seg-btn:first-child {
      border-left: none;
      border-radius: 0;
    }

    .tb-control-group > .tb-seg-btn:last-child,
    .panel-control-group > .tb-seg-btn:last-child {
      border-radius: 0;
    }

    .tb-seg-btn:hover {
      background: rgba(255, 255, 255, 0.05);
    }

    .tb-seg-btn:active {
      background: rgba(255, 255, 255, 0.08);
    }

    .tb-seg-btn:focus-visible {
      outline: 2px solid var(--accent2);
      outline-offset: -2px;
      z-index: 1;
    }

    .tb-win-btn {
      width: 52px;
      min-width: 52px;
      height: 100%;
      padding: 0;
      flex-shrink: 0;
      line-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.1s ease, color 0.1s ease;
      border-left: none;
    }

    .tb-win-btn:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .tb-win-btn:active {
      background: rgba(255, 255, 255, 0.12);
    }

    .tb-win-btn svg {
      width: 14px;
      height: 14px;
      display: block;
      flex-shrink: 0;
    }

    .tb-win-btn.close:hover {
      background: #dc3232;
      color: #fff;
    }

    .tb-win-btn.close:active {
      background: #c42b2b;
      color: #fff;
    }

    .tb-settings-btn {
      width: 48px;
      min-width: 48px;
      height: 100%;
      padding: 0;
      flex-shrink: 0;
      line-height: 0;
      color: var(--muted);
      transition: background 0.1s ease, color 0.1s ease;
    }

    .tb-settings-btn:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.08);
    }

    .tb-settings-btn:active {
      background: rgba(255, 255, 255, 0.12);
    }

    .tb-settings-btn svg {
      width: 15px;
      height: 15px;
      display: block;
      flex-shrink: 0;
    }

    .header-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 36px;
      padding: 0 14px;
      background: var(--btn-fill);
      border: 1px solid var(--btn-border);
      border-radius: var(--btn-radius);
      color: var(--text);
      font-family: 'Syne', sans-serif;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.12s ease, border-color 0.12s ease;
      white-space: nowrap;
    }

    .header-btn:hover {
      background: var(--btn-fill-hover);
      border-color: var(--btn-border-hover);
    }

    .header-btn:active {
      background: rgba(255, 255, 255, 0.08);
    }

    .header-btn:focus-visible {
      outline: 2px solid var(--accent2);
      outline-offset: 2px;
    }

    .header-btn svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      opacity: 0.9;
    }

    .header-btn-icon-only {
      width: 36px;
      min-width: 36px;
      padding: 0;
    }

    .header-btn-profile {
      padding: 0 12px 0 10px;
      max-width: 220px;
      transition: background 0.1s ease, color 0.1s ease;
      font-family: 'Syne', sans-serif;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .header-btn-profile:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .header-btn-profile:active {
      background: rgba(255, 255, 255, 0.12);
    }

    .header-btn-profile .profile-head-img {
      width: 24px;
      height: 24px;
      border-radius: 4px;
      box-shadow: none;
    }

    .header-btn-profile .profile-name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
      font-size: inherit;
      font-weight: inherit;
      color: var(--text);
    }

    .header-btn-profile .profile-chevron {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      transition: transform 0.2s ease, color 0.2s ease;
      flex-shrink: 0;
    }

    .header-btn-profile .profile-chevron svg {
      width: 12px;
      height: 12px;
      display: block;
    }

    .profile-wrap.open .header-btn-profile {
      background: rgba(255, 255, 255, 0.08);
    }

    .profile-wrap.open .header-btn-profile .profile-chevron {
      transform: rotate(180deg);
      color: var(--accent2);
    }

    .layout {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: row;
      align-items: stretch;
      width: 100%;
      height: 100vh;
      padding-top: 52px;
      box-sizing: border-box;
      min-height: 0;
      transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .layout.closing {
      transform: scale(1.1);
      opacity: 0;
      filter: blur(20px);
    }

    .right-panel {
      position: relative;
      width: 540px;
      max-width: 100%;
      flex-shrink: 0;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 0;
      padding: 48px 32px 48px 48px;
      background: transparent;
      gap: 0;
      box-sizing: border-box;
    }

    .player-model-panel {
      position: relative;
      flex: 1;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      min-width: 0;
      padding: 0 40px 72px 16px;
      overflow: hidden;
    }

    .player-model-panel::before {
      content: '';
      position: absolute;
      bottom: 16%;
      left: 50%;
      transform: translateX(-50%);
      width: min(282px, 68%);
      height: 46px;
      background: radial-gradient(ellipse at center, var(--player-glow) 0%, transparent 70%);
      filter: blur(8px);
      pointer-events: none;
    }

    #playerSkinCanvas {
      display: block;
      max-width: 100%;
      position: relative;
      z-index: 1;
      cursor: grab;
    }

    #playerSkinCanvas:active {
      cursor: grabbing;
    }

    @media (max-width: 720px) {
      .player-model-panel {
        display: none;
      }
    }

    /* ── PROFILE CHANGER ── */
    .profile-wrap {
      position: relative;
      z-index: 110;
    }

    .profile-head-img {
      width: 24px;
      height: 24px;
      border-radius: 4px;
      image-rendering: pixelated;
      box-shadow: none;
      background: var(--muted);
      flex-shrink: 0;
    }

    .profile-name {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text);
    }

    .profile-dropdown {
      position: absolute;
      top: 100%;
      right: 0;
      width: 280px;
      background: var(--chrome);
      border: 1px solid var(--border);
      border-top: none;
      border-radius: 0;
      padding: 0;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transform-origin: top right;
      transition: opacity 0.15s ease, visibility 0.15s ease, transform 0.15s ease;
      backdrop-filter: blur(16px);
    }

    .profile-wrap.open .profile-dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .profile-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .profile-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: 0;
      cursor: pointer;
      transition: background 0.1s ease;
      border: none;
      border-bottom: 1px solid var(--border);
      position: relative;
    }

    .profile-item:last-child {
      border-bottom: none;
    }

    .profile-item:hover {
      background: rgba(255, 255, 255, 0.05);
    }

    .profile-item.active {
      background: rgba(255, 255, 255, 0.04);
      box-shadow: inset 2px 0 0 var(--accent);
    }

    .profile-info {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-width: 0;
    }

    .profile-item-name {
      font-family: 'Syne', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text);
      letter-spacing: 0;
    }

    .profile-item-type {
      font-family: 'Syne', sans-serif;
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.01em;
      margin-top: 3px;
    }

    .profile-check {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
      opacity: 0;
      transform: scale(0.5);
      transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
      pointer-events: none;
    }

    .profile-check svg {
      width: 14px;
      height: 14px;
      display: block;
    }

    .profile-item.active .profile-check {
      opacity: 1;
      transform: scale(1);
    }

    .profile-item:hover .profile-check {
      opacity: 0;
      transform: scale(0.5);
    }

    .profile-actions {
      position: relative;
      width: 28px;
      height: 28px;
      flex-shrink: 0;
    }

    .profile-delete {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ff5555;
      opacity: 0;
      transform: scale(0.35) rotate(-90deg);
      transform-origin: 50% 50%;
      border-radius: 4px;
      background: transparent;
      box-shadow: inset 0 0 0 1px transparent;
      line-height: 0;
      transition:
        opacity 0.22s ease,
        transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
        color 0.2s ease,
        background 0.22s ease,
        box-shadow 0.22s ease;
      cursor: pointer;
    }

    .profile-delete svg {
      width: 13px;
      height: 13px;
      display: block;
      flex-shrink: 0;
    }

    .profile-item:hover .profile-delete {
      opacity: 1;
      transform: scale(1) rotate(0deg);
      background: rgba(255, 68, 68, 0.14);
      box-shadow: inset 0 0 0 1px rgba(255, 68, 68, 0.28);
    }

    .profile-item:hover .profile-delete:hover {
      background: rgba(255, 68, 68, 0.22);
      box-shadow: inset 0 0 0 1px rgba(255, 68, 68, 0.4);
      color: #ff7777;
      transform: scale(1.04) rotate(0deg);
    }

    .profile-divider {
      height: 1px;
      background: var(--border);
      margin: 0;
    }

    /* Custom Modal */
    .custom-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .custom-modal {
      background: #0a0a16;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      min-width: 300px;
      max-width: 400px;
      text-align: center;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.65);
    }

    .custom-modal-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .custom-modal-message {
      color: var(--text);
      margin-bottom: 20px;
      font-size: 0.9rem;
      opacity: 0.8;
    }

    .custom-modal-buttons {
      display: flex;
      gap: 12px;
      justify-content: center;
    }

    .custom-modal-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 34px;
      padding: 0 18px;
      border-radius: var(--btn-radius);
      border: 1px solid var(--btn-border);
      background: var(--btn-fill);
      color: var(--text);
      cursor: pointer;
      font-family: 'Syne', sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      transition: background 0.12s ease, border-color 0.12s ease;
    }

    .custom-modal-btn:hover {
      background: var(--btn-fill-hover);
      border-color: var(--btn-border-hover);
    }

    .custom-modal-btn:active {
      background: rgba(255, 255, 255, 0.08);
    }

    .custom-modal-btn.confirm {
      background: #c43c3c;
      border-color: #d45a5a;
      color: #fff;
    }

    .custom-modal-btn.confirm:hover {
      background: #d44848;
      border-color: #e07070;
      color: #fff;
    }

    .custom-modal-btn.confirm:active {
      background: #b43434;
    }

    .custom-modal-btn.cancel {
      color: var(--text);
    }

    .custom-modal-btn.primary {
      background: var(--accent);
      border-color: color-mix(in srgb, var(--accent) 70%, white 18%);
      color: #fff;
    }

    .custom-modal-btn.primary:hover {
      background: color-mix(in srgb, var(--accent) 88%, white 12%);
      border-color: color-mix(in srgb, var(--accent) 55%, white 28%);
      color: #fff;
    }

    .custom-modal-btn.primary:active {
      background: color-mix(in srgb, var(--accent) 78%, black 10%);
    }

    .add-account-btn {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: 0;
      cursor: pointer;
      transition: background 0.1s ease, color 0.1s ease;
      color: var(--text);
      font-family: 'Syne', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      text-transform: none;
    }

    .add-account-btn:hover {
      background: rgba(255, 255, 255, 0.05);
      color: var(--accent2);
    }

    .add-icon-wrap {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 4px;
      color: inherit;
      transition: border-color 0.1s ease, color 0.1s ease;
      flex-shrink: 0;
    }

    .add-icon-wrap svg {
      width: 12px;
      height: 12px;
      display: block;
    }

    .add-account-btn:hover .add-icon-wrap {
      background: transparent;
      border-color: rgba(240, 168, 66, 0.35);
      color: var(--accent2);
    }

    /* ── END PROFILE CHANGER ── */

    .game-label {
      font-family: 'Space Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 10px;
    }

    .game-title {
      font-size: 2rem;
      font-weight: 800;
      line-height: 0.95;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
      background: linear-gradient(130deg, var(--text) 40%, var(--accent2) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .game-subtitle {
      font-family: 'Space Mono', monospace;
      font-size: 0.62rem;
      color: var(--muted);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 40px;
    }

    .divider {
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, var(--accent) 0%, transparent 100%);
      margin-bottom: 36px;
      opacity: 0.4;
    }

    /* ── PLAY BUTTON ── */
    .play-wrap {
      position: relative;
      margin-bottom: 0;
    }

    .version-label {
      font-family: 'Space Mono', monospace;
      font-size: 0.7rem;
      color: var(--muted);
      text-align: center;
      margin-top: 10px;
      letter-spacing: 0.05em;
    }

    .version-label span {
      color: var(--accent);
    }

    .playtime-label {
      font-family: 'Space Mono', monospace;
      font-size: 0.62rem;
      color: var(--muted);
      text-align: center;
      margin-top: 6px;
      letter-spacing: 0.08em;
    }

    .panel-actions {
      position: fixed;
      top: 72px;
      right: 24px;
      z-index: 90;
      pointer-events: none;
    }

    .panel-control-group {
      display: inline-flex;
      align-items: stretch;
      height: 44px;
      max-width: min(420px, calc(100vw - 48px));
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: visible;
      background: transparent;
      pointer-events: auto;
      -webkit-app-region: no-drag;
    }

    .panel-control-group .header-btn-profile {
      min-width: 0;
      flex: 1 1 auto;
      border-radius: 10px 0 0 10px;
    }

    .panel-control-group .header-btn-profile:hover,
    .panel-control-group .header-btn-profile:active,
    .panel-control-group .profile-wrap.open .header-btn-profile {
      border-radius: 10px 0 0 10px;
    }

    .panel-control-group .tb-settings-btn,
    .panel-control-group .tb-settings-btn:hover,
    .panel-control-group .tb-settings-btn:active {
      border-radius: 0 10px 10px 0;
    }

    .panel-control-group .profile-wrap.open {
      z-index: 120;
    }

    .panel-control-group .profile-dropdown {
      top: calc(100% + 8px);
      border-top: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
      overflow: hidden;
    }

    .panel-control-group .profile-dropdown .profile-item:first-child {
      border-radius: 10px 10px 0 0;
    }

    .panel-control-group .profile-dropdown .profile-item:first-child:last-child {
      border-radius: 10px 10px 0 0;
    }

    .panel-control-group .profile-dropdown .add-account-btn {
      border-radius: 0 0 10px 10px;
    }

    .panel-control-group .tb-seg-btn {
      border-left-color: rgba(255, 255, 255, 0.08);
    }

    .panel-control-group .profile-wrap {
      display: flex;
      align-items: stretch;
      height: 100%;
      border-radius: 10px 0 0 10px;
      overflow: hidden;
    }

    .panel-control-group .profile-wrap.open {
      overflow: visible;
    }

    .panel-control-group .tb-seg-btn {
      height: 100%;
    }

    .play-btn {
      width: 100%;
      height: 54px;
      background: var(--accent);
      border: none;
      border-radius: 10px;
      color: #fff;
      font-family: 'Syne', sans-serif;
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 24px var(--glow), 0 1px 0 rgba(255, 255, 255, 0.15) inset;
      display: flex;
      align-items: center;
    }

    .btn-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: btn-spin 0.8s linear infinite;
      display: inline-block;
      vertical-align: middle;
    }

    #playBtnIcon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      vertical-align: middle;
    }

    #playBtnIcon svg {
      width: 14px;
      height: 14px;
      display: block;
    }

    @keyframes btn-spin {
      to { transform: rotate(360deg); }
    }

    .play-btn.stop-mode {
      background: #b83232;
      box-shadow: 0 4px 24px rgba(184, 50, 50, 0.35), 0 1px 0 rgba(255, 255, 255, 0.12) inset;
    }

    .play-btn.stop-mode .play-btn-version,
    .play-btn.launching .play-btn-version {
      display: none;
    }

    .play-btn-main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 12px;
      position: relative;
      height: 100%;
    }

    .play-status-text {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .play-btn-main::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
      transition: left 0.55s ease;
      pointer-events: none;
    }

    .play-btn:hover .play-btn-main::before {
      left: 150%;
    }

    .play-btn-version {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 72px;
      flex-shrink: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.15);
      gap: 2px;
      transition: background 0.2s;
      padding: 0 8px;
      cursor: pointer;
      height: 100%;
      position: relative;
      z-index: 2;
    }

    .play-btn-version:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .play-btn-version:hover ~ .play-btn-main::before {
      display: none;
    }

    .play-btn-ver-icon {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.5);
      line-height: 1;
    }

    .play-btn:not(:disabled):hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 32px var(--glow-strong), 0 1px 0 rgba(255, 255, 255, 0.2) inset;
      background: var(--accent-hover);
    }

    .play-btn.stop-mode:not(:disabled):hover {
      background: #cf3a3a;
      box-shadow: 0 8px 32px rgba(184, 50, 50, 0.5), 0 1px 0 rgba(255, 255, 255, 0.15) inset;
    }

    .play-btn.stop-mode:not(:disabled):active {
      background: #b83232;
      box-shadow: 0 4px 20px rgba(184, 50, 50, 0.4), 0 1px 0 rgba(255, 255, 255, 0.12) inset;
    }

    .play-btn:active {
      transform: translateY(1px);
    }

    .play-btn:disabled {
      cursor: default;
      opacity: 0.85;
    }

    .play-btn.launching {
      animation: launch-pulse 0.4s ease, btn-blink 1.5s ease-in-out infinite;
    }

    @keyframes launch-pulse {
      0% {
        box-shadow: 0 0 0px var(--glow-pulse-start);
      }

      50% {
        box-shadow: 0 0 60px var(--glow-pulse-mid), 0 0 100px var(--glow-pulse-outer);
      }

      100% {
        box-shadow: 0 4px 24px var(--glow);
      }
    }

    @keyframes btn-blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }

    /* ── VERSION POPUP ── */
    .version-popup {
      position: fixed;
      top: 52px;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--chrome);
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.15s ease, visibility 0.15s;
      backdrop-filter: blur(16px);
    }

    .version-popup.show {
      opacity: 1;
      visibility: visible;
      pointer-events: all;
    }

    .version-popup-panel {
      width: min(360px, calc(100vw - 48px));
      max-height: min(480px, calc(100vh - 120px));
      background: #12121c;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      transform: translateY(8px);
      opacity: 0;
      transition: transform 0.2s ease, opacity 0.2s ease;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.75);
    }

    .version-popup.show .version-popup-panel {
      transform: translateY(0);
      opacity: 1;
    }

    .version-popup-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      padding: 20px 20px 12px;
      flex-shrink: 0;
    }

    .version-popup-search {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0 16px 12px;
      padding: 4px 10px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 10px;
      flex-shrink: 0;
      transition: border-color 0.15s ease, background 0.15s ease;
    }

    .version-popup-search:focus-within {
      border-color: var(--btn-border-hover);
      background: rgba(255, 255, 255, 0.06);
    }

    .version-popup-search-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      flex-shrink: 0;
      transition: color 0.15s ease;
    }

    .version-popup-search:focus-within .version-popup-search-icon {
      color: var(--accent2);
    }

    .version-popup-search-icon svg {
      width: 14px;
      height: 14px;
      display: block;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .version-popup-search-input {
      flex: 1;
      min-width: 0;
      padding: 6px 0;
      background: transparent;
      border: none;
      color: var(--text);
      font-family: 'Syne', sans-serif;
      font-size: 0.88rem;
      letter-spacing: 0;
      outline: none;
    }

    .version-popup-search-input::placeholder {
      color: var(--muted);
      opacity: 0.75;
    }

    .version-popup-search-input::-webkit-search-cancel-button {
      display: none;
    }

    .version-popup-empty {
      padding: 24px 16px;
      text-align: center;
      font-family: 'Syne', sans-serif;
      font-size: 0.8125rem;
      color: var(--muted);
      line-height: 1.5;
    }

    .version-popup-heading {
      font-family: 'Syne', sans-serif;
      font-size: 1.0625rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 2px;
      letter-spacing: -0.02em;
      line-height: 1.4;
    }

    .version-popup-desc {
      font-family: 'Syne', sans-serif;
      font-size: 0.8125rem;
      font-weight: 400;
      color: var(--muted);
      line-height: 1.55;
    }

    .version-popup-close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      flex-shrink: 0;
      background: var(--btn-fill);
      border: 1px solid var(--btn-border);
      border-radius: var(--btn-radius);
      color: var(--muted);
      cursor: pointer;
      transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
    }

    .version-popup-close svg {
      width: 14px;
      height: 14px;
      display: block;
    }

    .version-popup-close:hover {
      background: var(--btn-fill-hover);
      color: var(--text);
      border-color: var(--btn-border-hover);
    }

    .version-popup-list {
      overflow-y: auto;
      flex: 1;
      min-height: 0;
      scroll-behavior: smooth;
    }

    .version-popup-list::-webkit-scrollbar {
      width: 6px;
    }

    .version-popup-list::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.05);
    }

    .version-popup-list::-webkit-scrollbar-thumb {
      background: var(--accent);
      border-radius: 3px;
    }

    /* ── LOADER SWITCHER (matches profile switcher) ── */
    .loader-wrap {
      position: relative;
      z-index: 25;
    }

    .loader-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      padding: 12px 14px;
      background: rgba(255,255,255,0.045);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      cursor: pointer;
      transition: background 0.15s ease, border-color 0.15s ease;
      text-align: left;
    }

    .loader-trigger:hover {
      background: rgba(255,255,255,0.07);
      border-color: rgba(255,255,255,0.14);
    }

    .loader-wrap.open {
      z-index: 51;
    }

    .loader-wrap.open .loader-trigger {
      background: #12121c;
      border-color: rgba(255, 255, 255, 0.12);
    }

    .loader-trigger:focus-visible {
      outline: 2px solid var(--accent2);
      outline-offset: -2px;
    }

    .loader-trigger-info {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-width: 0;
    }

    .loader-trigger-name {
      font-family: 'Syne', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text);
      letter-spacing: 0;
      line-height: 1.4;
    }

    .loader-trigger-type {
      font-family: 'Syne', sans-serif;
      font-size: 0.75rem;
      color: var(--muted);
      letter-spacing: 0.01em;
      margin-top: 3px;
      line-height: 1.4;
    }

    .loader-trigger-chevron {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      transition: transform 0.2s ease, color 0.2s ease;
      flex-shrink: 0;
    }

    .loader-trigger-chevron svg {
      width: 12px;
      height: 12px;
      display: block;
    }

    .loader-wrap.open .loader-trigger-chevron {
      transform: rotate(180deg);
      color: var(--accent2);
    }

    .loader-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 52;
      background: #12121c;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-top: none;
      border-radius: 0;
      padding: 0;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.75);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transform-origin: top center;
      transition: opacity 0.15s ease, visibility 0.15s ease, transform 0.15s ease;
    }

    .loader-wrap.open .loader-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .loader-list {
      display: flex;
      flex-direction: column;
      gap: 0;
      background: #12121c;
    }

    .loader-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: 0;
      cursor: pointer;
      transition: background 0.1s ease;
      border: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
      width: 100%;
      background: #12121c;
      text-align: left;
    }

    .loader-item:last-child {
      border-bottom: none;
    }

    .loader-item:hover {
      background: #1a1a28;
    }

    .loader-item.active {
      background: #1e1a24;
      box-shadow: inset 2px 0 0 var(--accent);
    }

    .loader-item-info {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-width: 0;
    }

    .loader-item-name {
      font-family: 'Syne', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text);
      letter-spacing: 0;
      line-height: 1.4;
    }

    .loader-item-type {
      font-family: 'Syne', sans-serif;
      font-size: 0.75rem;
      color: var(--muted);
      letter-spacing: 0.01em;
      margin-top: 3px;
      line-height: 1.4;
    }

    .loader-item-playtime {
      font-family: 'Syne', sans-serif;
      font-size: 0.75rem;
      color: var(--muted);
      letter-spacing: 0;
      margin-top: 2px;
      line-height: 1.4;
      opacity: 0.9;
    }

    .loader-item-actions {
      position: relative;
      width: 28px;
      height: 28px;
      flex-shrink: 0;
    }

    .loader-check {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
      opacity: 0;
      transform: scale(0.5);
      transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
      pointer-events: none;
    }

    .loader-check svg {
      width: 14px;
      height: 14px;
      display: block;
    }

    .loader-item.active .loader-check {
      opacity: 1;
      transform: scale(1);
    }

    .loader-item:hover .loader-check {
      opacity: 0;
      transform: scale(0.5);
    }

    /* ── OPEN MODS BUTTON ── */
    .open-mods-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 18px;
      background: rgba(255,255,255,0.045);
      border: 1px solid var(--border);
      border-radius: 10px;
      cursor: pointer;
      transition: background 0.15s ease, border-color 0.15s ease;
      color: var(--text);
      font-family: 'Syne', sans-serif;
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      width: 100%;
    }

    .open-mods-btn:hover {
      background: rgba(255,255,255,0.07);
      border-color: rgba(255,255,255,0.14);
    }

    .open-mods-icon {
      width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: var(--muted);
      transition: color 0.15s ease;
    }

    .open-mods-icon svg {
      width: 18px;
      height: 18px;
      display: block;
    }

    .open-mods-btn:hover .open-mods-icon {
      color: var(--accent);
    }

    .open-mods-arrow {
      margin-left: auto;
      color: var(--muted);
      display: flex;
      align-items: center;
      transition: color 0.15s ease, transform 0.15s ease;
    }

    .open-mods-arrow svg {
      width: 14px;
      height: 14px;
      display: block;
    }

    .open-mods-btn:hover .open-mods-arrow {
      color: var(--accent2);
      transform: translateX(2px);
    }

    .settings-tab-icon svg,
    .open-mods-icon svg,
    .open-mods-arrow svg,
    .log-action-btn svg,
    .log-empty-icon svg,
    .mod-btn.remove svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .settings-tab-icon {
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: currentColor;
      opacity: 0.7;
    }

    .settings-tab.active .settings-tab-icon {
      opacity: 1;
      color: var(--accent2);
    }

    .settings-tab-icon svg {
      width: 18px;
      height: 18px;
      display: block;
    }

    .settings-inline-icon {
      display: inline-flex;
      align-items: center;
      vertical-align: middle;
      margin-right: 4px;
    }

    .settings-inline-icon svg {
      width: 13px;
      height: 13px;
      display: block;
    }

    /* ── SETTINGS PANEL (Redesigned) ── */
    .settings-overlay {
      position: fixed;
