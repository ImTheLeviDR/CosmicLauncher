      const overlay = document.getElementById('onboardOverlay');
      if (!overlay) return;

      const pages = [...overlay.querySelectorAll('.onboard-page')];
      const dotsEl = document.getElementById('onboardDots');
      const nextBtn = document.getElementById('onboardNext');
      const backBtn = document.getElementById('onboardBack');
      const skipBtn = document.getElementById('onboardSkip');
      const loginBtn = document.getElementById('onboardLoginBtn');
      const searchEl = document.getElementById('onboardImportSearch');
      const listEl = document.getElementById('onboardImportList');
      const total = pages.length;
      let page = 0;
      let importLoaded = false;
      let importInstances = [];
      const importedIds = new Set();

      dotsEl.innerHTML = pages.map((_, i) => `<span class="onboard-dot${i === 0 ? ' active' : ''}"></span>`).join('');
      const dots = [...dotsEl.querySelectorAll('.onboard-dot')];

      function setPage(next, direction = 1) {
        page = Math.max(0, Math.min(total - 1, next));
        pages.forEach((el, i) => {
          const active = i === page;
          el.classList.toggle('active', active);
          el.classList.toggle('from-back', active && direction < 0);
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === page);
          dot.classList.toggle('done', i < page);
        });
        backBtn.hidden = page === 0;
        skipBtn.hidden = page !== 0;
        nextBtn.textContent = page === total - 1 ? 'Enter Cosmic' : 'Continue';
        if (page === 3) loadOnboardImports();
        if (page === total - 1) updateOnboardReady();
      }

      updateOnboardAccount = function() {
        const nameEl = document.getElementById('activeProfileName');
        const card = document.getElementById('onboardAccountCard');
        const img = document.getElementById('onboardAccountImg');
        const nameOut = document.getElementById('onboardAccountName');
        const metaOut = document.getElementById('onboardAccountMeta');
        const title = overlay.querySelector('[data-page="2"] .onboard-title');
        const copy = overlay.querySelector('[data-page="2"] .onboard-copy');
        const label = document.getElementById('onboardLoginLabel');
        const uuid = nameEl ? nameEl.dataset.uuid : '';
        const name = nameEl ? nameEl.textContent : '';
        const signedIn = Boolean(uuid) && name && name !== 'Account' && name !== 'Select Account';

        if (title) title.textContent = signedIn ? 'You are signed in' : 'Sign in to play';
        if (copy) {
          copy.textContent = signedIn
            ? 'This Microsoft account will be used to launch Minecraft. You can add more later.'
            : 'Cosmic uses your Microsoft account to launch Minecraft. You can add it later from the home screen.';
        }
        if (label) label.textContent = signedIn ? 'Use a different account' : 'Sign in with Microsoft';
        if (card) card.hidden = !signedIn;
        if (signedIn && nameOut) nameOut.textContent = name;
        if (signedIn && metaOut) metaOut.textContent = 'Microsoft account';
        if (signedIn && img) setProfileAvatarImg(img, uuid, name, true);
      };

      function updateOnboardReady() {
        const avatar = document.getElementById('onboardSummaryAvatar');
        const nameOut = document.getElementById('onboardSummaryName');
        const subOut = document.getElementById('onboardSummarySub');
        const swatch = document.getElementById('onboardSummarySwatch');
        const themeOut = document.getElementById('onboardSummaryTheme');
        const packsOut = document.getElementById('onboardSummaryPacks');
        const importRow = document.getElementById('onboardSummaryImportRow');
        const importsOut = document.getElementById('onboardSummaryImports');
        if (!nameOut) return;

        const nameEl = document.getElementById('activeProfileName');
        const uuid = nameEl ? nameEl.dataset.uuid : '';
        const name = nameEl ? nameEl.textContent : '';
        const signedIn = Boolean(uuid) && name && name !== 'Account' && name !== 'Select Account';

        nameOut.textContent = signedIn ? name : 'No account yet';
        subOut.textContent = signedIn ? 'Microsoft account' : 'Sign in anytime from the header';
        if (avatar) setProfileAvatarImg(avatar, signedIn ? uuid : null, signedIn ? name : 'Steve', true);

        const themeId = selectedTheme === 'auto' ? resolvedAutoTheme : selectedTheme;
        const themeDef = COLOR_THEMES.find((item) => item.id === themeId) || COLOR_THEMES[0];
        if (themeOut) themeOut.textContent = selectedTheme === 'auto' ? `Auto · ${themeDef.label}` : themeDef.label;
        if (swatch) swatch.style.background = `linear-gradient(135deg, ${themeDef.accent}, ${themeDef.accent2})`;

        const packCount = Array.isArray(modpacks) ? modpacks.length : 1;
        if (packsOut) packsOut.textContent = `${packCount} ready to play`;

        const importCount = importedIds.size;
        if (importRow) importRow.hidden = importCount === 0;
        if (importsOut) importsOut.textContent = `${importCount} from Modrinth`;
      }

      function renderOnboardImports(filter = '') {
        const query = filter.trim().toLowerCase();
        const filtered = importInstances.filter((item) => {
          const haystack = `${item.name} ${item.version || ''} ${item.loaderLabel || ''}`.toLowerCase();
          return !query || haystack.includes(query);
        });
        if (!filtered.length) {
          const empty = importInstances.length
            ? 'No instances match that search.'
            : 'No Modrinth instances found.';
          listEl.innerHTML = `<div class="import-instance-empty">${empty}</div>`;
          return;
        }
        listEl.innerHTML = filtered.map((item) => {
          const imported = importedIds.has(item.id);
          const meta = [item.version || 'Unknown version', item.loaderLabel || 'Unknown loader', formatPlayTime(item.playTimeMs)].join(' · ');
          const warning = item.supported ? '' : `<div class="import-instance-warning">Cosmic launches Vanilla and Fabric. Files will still be copied.</div>`;
          return `<div class="onboard-instance${imported ? ' imported' : ''}">
            <div>
              <div class="onboard-instance-name">${escapeHtml(item.name)}</div>
              <div class="onboard-instance-meta">${escapeHtml(meta)}</div>
              ${warning}
            </div>
            <button type="button" class="mod-btn install" data-onboard-import="${escapeHtml(item.id)}" ${imported ? 'disabled' : ''}>${imported ? 'Imported' : 'Import'}</button>
          </div>`;
        }).join('');

        listEl.querySelectorAll('[data-onboard-import]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-onboard-import');
            btn.disabled = true;
            btn.textContent = 'Importing...';
            listEl.querySelectorAll('[data-onboard-import]').forEach((other) => { other.disabled = true; });
            try {
              const result = await ipcRenderer.invoke('modpacks:importModrinth', id);
              if (!result.success) {
                showModal('Import failed', result.error || 'Could not import that instance', true);
                renderOnboardImports(searchEl.value);
                return;
              }
              importedIds.add(id);
              await selectModpack(result.pack.id);
              const extra = result.indexedMods ? ` · ${result.indexedMods} mods indexed` : '';
              showToast('Instance imported', `${result.pack.name}${extra}`);
              renderOnboardImports(searchEl.value);
            } catch (err) {
              showModal('Import failed', err.message, true);
              renderOnboardImports(searchEl.value);
            }
          });
        });
      }

      function loadOnboardImports() {
        if (importLoaded || !ipcRenderer) return;
        importLoaded = true;
        ipcRenderer.invoke('modpacks:listModrinth').then((result) => {
          if (!result.success) {
            listEl.innerHTML = `<div class="import-instance-empty">${escapeHtml(result.error || 'Could not read Modrinth instances.')}</div>`;
            return;
          }
          if (!result.foundApp) {
            listEl.innerHTML = '<div class="import-instance-empty">Modrinth App was not found on this computer. You can import later from Modpacks.</div>';
            return;
          }
          importInstances = result.instances || [];
          renderOnboardImports(searchEl.value);
        }).catch((err) => {
          listEl.innerHTML = `<div class="import-instance-empty">${escapeHtml(err.message)}</div>`;
        });
      }

      async function finishOnboarding() {
        overlay.classList.add('leaving');
        document.body.classList.remove('needs-onboarding');
        try {
          if (ipcRenderer) await ipcRenderer.invoke('onboarding:complete');
        } catch (err) {
          console.error('Failed to save onboarding state:', err);
        }
        setTimeout(() => {
          checkLauncherUpdates(false);
        }, 560);
      }

      async function startOnboardingReplayInner() {
        closeSettings();
        overlay.classList.remove('leaving');
        importLoaded = false;
        importedIds.clear();
        if (searchEl) searchEl.value = '';
        if (listEl) listEl.innerHTML = '<div class="import-instance-empty">Looking for Modrinth App...</div>';
        setPage(0, 1);
        updateOnboardAccount();
        document.body.classList.add('needs-onboarding');
        try {
          if (ipcRenderer) await ipcRenderer.invoke('onboarding:reset');
        } catch (err) {
          console.error('Failed to reset onboarding state:', err);
        }
      }

      startOnboardingReplay = startOnboardingReplayInner;

      nextBtn.addEventListener('click', () => {
        if (page >= total - 1) {
          finishOnboarding();
          return;
        }
        setPage(page + 1, 1);
      });
      backBtn.addEventListener('click', () => setPage(page - 1, -1));
      skipBtn.addEventListener('click', () => finishOnboarding());
      if (loginBtn) {
        loginBtn.addEventListener('click', () => addMicrosoftAccount());
      }
      if (searchEl) {
        searchEl.addEventListener('input', () => renderOnboardImports(searchEl.value));
      }

      overlay.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' || e.repeat) return;
        if (e.target && e.target.tagName === 'INPUT') return;
        e.preventDefault();
        nextBtn.click();
      });

      updateOnboardAccount();
      setPage(0, 1);
    }

/* ── MODPACK + LOADER STATE ── */
    let selectedLoader = '<%= loader %>';
    let selectedModpackId = '<%= selectedModpack ? selectedModpack.id : "default" %>';
    let modpacks = <%- JSON.stringify(modpacks || []) %>;
    let resolvedLatestVersion = null;
    let modDetailReturnTab = 'browse';
    let currentModDetail = null;

    const loaderOptions = {
      vanilla: { label: 'Vanilla', type: 'Unmodified' },
      fabric: { label: 'Fabric', type: 'Mod loader' },
    };

    function getSelectedModpack() {
      return modpacks.find(p => p.id === selectedModpackId) || modpacks[0] || null;
    }

    function formatModpackMeta(pack) {
      if (!pack) return '';
      const versionLabel = pack.version === 'latest'
        ? (resolvedLatestVersion ? `Latest (${resolvedLatestVersion})` : 'Latest')
        : pack.version;
      const loaderId = (pack.sourceLoader || pack.loader || 'vanilla').toLowerCase();
      const loaderLabels = { vanilla: 'Vanilla', fabric: 'Fabric', forge: 'Forge', neoforge: 'NeoForge', quilt: 'Quilt' };
      const loaderLabel = loaderLabels[loaderId] || (loaderId.charAt(0).toUpperCase() + loaderId.slice(1));
      return `${versionLabel} · ${loaderLabel}`;
    }

    function formatPlayTimeCompact(ms) {
      const totalSeconds = Math.max(0, Math.floor((Number(ms) || 0) / 1000));
      if (totalSeconds < 60) return totalSeconds > 0 ? `${totalSeconds}s` : '';
      const totalMinutes = Math.floor(totalSeconds / 60);
      const days = Math.floor(totalMinutes / (60 * 24));
      const hours = Math.floor((totalMinutes / 60) % 24);
      const minutes = totalMinutes % 60;
      if (days > 0) return hours > 0 ? `${days}d ${hours}h` : `${days}d`;
      if (hours > 0) return minutes > 0 ? `${hours}h ${minutes}m` : `${hours}h`;
      return `${minutes}m`;
    }

    function formatPlayTime(ms) {
      const compact = formatPlayTimeCompact(ms);
      return compact ? `Played ${compact}` : 'Not played yet';
    }

    function applyPlayTimeUpdates(updates) {
      if (!Array.isArray(updates) || !updates.length) return;
      let changed = false;
      for (const update of updates) {
        const pack = modpacks.find(p => p.id === update.modpackId);
        if (!pack) continue;
        pack.playTimeMs = update.playTimeMs;
        if (update.lastPlayedAt) pack.lastPlayedAt = update.lastPlayedAt;
        changed = true;
        document.querySelectorAll(`[data-playtime-id="${pack.id}"]`).forEach((el) => {
          if (el.closest('.modpack-card')) {
            const play = formatPlayTimeCompact(pack.playTimeMs);
            el.textContent = play ? `${formatModpackMeta(pack)} · ${play}` : formatModpackMeta(pack);
          } else {
            el.textContent = formatPlayTime(pack.playTimeMs);
          }
        });
      }
      if (!changed) return;
      const selected = getSelectedModpack();
      const playtimeLabel = document.getElementById('playtimeLabel');
      if (playtimeLabel) playtimeLabel.textContent = formatPlayTime(selected?.playTimeMs);
    }

    function syncSelectedFromModpack(pack) {
      if (!pack) return;
      selectedModpackId = pack.id;
      selectedLoader = pack.loader || 'vanilla';
      selectedVersion = pack.version === 'latest'
        ? (resolvedLatestVersion || 'latest')
        : pack.version;
    }

    async function loadModpacks() {
      try {
        const result = await ipcRenderer.invoke('modpacks:list');
        if (result.success) {
          modpacks = result.modpacks || [];
          selectedModpackId = result.selectedId || selectedModpackId;
          const pack = getSelectedModpack();
          syncSelectedFromModpack(pack);
          updateVersionUI();
          renderModpackSettingsList();
          const syncToggle = document.getElementById('syncOptionsToggle');
          if (syncToggle && typeof result.syncOptionsAcrossModpacks === 'boolean') {
            updateToggleUI(syncToggle, result.syncOptionsAcrossModpacks);
          }
        }
      } catch (e) {
        console.warn('Could not load modpacks:', e);
      }
    }

    function updateToggleUI(wrap, enabled) {
      wrap.dataset.enabled = enabled ? 'true' : 'false';
      wrap.classList.toggle('on', enabled);
      const label = wrap.querySelector('span');
      if (label) label.textContent = enabled ? 'On' : 'Off';
    }

    function renderModpackSettingsList() {
      const list = document.getElementById('modpackSettingsList');
      if (!list) return;
      const query = (modpackSettingsQuery || '').trim().toLowerCase();
      const filtered = modpacks.filter((pack) => {
        if (!query) return true;
        return pack.name.toLowerCase().includes(query)
          || String(pack.version).toLowerCase().includes(query)
          || String(pack.loader).toLowerCase().includes(query)
          || formatModpackMeta(pack).toLowerCase().includes(query);
      }).slice().sort((a, b) => {
        if (modpackSortBy === 'played') return (b.lastPlayedAt || 0) - (a.lastPlayedAt || 0);
        if (modpackSortBy === 'time') return (b.playTimeMs || 0) - (a.playTimeMs || 0);
        return a.name.localeCompare(b.name, undefined, { sensitivity: 'base' });
      });
      if (!filtered.length) {
        list.innerHTML = `<div class="mods-empty" style="padding:24px;grid-column:1/-1">${modpacks.length ? 'No modpacks match your search.' : 'No modpacks yet.'}</div>`;
        return;
      }
      list.innerHTML = filtered.map(pack => {
        const active = pack.id === selectedModpackId;
        const canEdit = !pack.isDefault;
        const play = formatPlayTimeCompact(pack.playTimeMs);
        const meta = play ? `${formatModpackMeta(pack)} · ${play}` : formatModpackMeta(pack);
        return `<div class="modpack-card${active ? ' active' : ''}" data-select="${pack.id}">
          <div class="modpack-card-icon" data-icon="mods" aria-hidden="true"></div>
          <div class="modpack-card-info">
            <div class="modpack-card-name">${escapeHtml(pack.name)}</div>
            <div class="modpack-card-meta"><span data-icon="loader" aria-hidden="true"></span><span data-playtime-id="${pack.id}">${escapeHtml(meta)}</span></div>
          </div>
          ${canEdit ? `<div class="modpack-card-actions">
            <button type="button" class="modpack-card-icon-btn" data-edit="${pack.id}" title="Edit"><span data-icon="edit" aria-hidden="true"></span></button>
            <button type="button" class="modpack-card-icon-btn danger" data-delete="${pack.id}" title="Delete"><span data-icon="trash" aria-hidden="true"></span></button>
          </div>` : ''}
        </div>`;
      }).join('');

      initSettingsIcons(list);
      list.querySelectorAll('.modpack-card[data-select]').forEach(card => {
        card.onclick = (e) => {
          if (e.target.closest('[data-edit], [data-delete]')) return;
          if (card.dataset.select !== selectedModpackId) selectModpack(card.dataset.select);
        };
      });
      list.querySelectorAll('[data-edit]').forEach(btn => {
        btn.onclick = (e) => {
          e.stopPropagation();
          openEditModpackModal(btn.dataset.edit);
        };
      });
      list.querySelectorAll('[data-delete]').forEach(btn => {
        btn.onclick = (e) => {
          e.stopPropagation();
          deleteModpack(btn.dataset.delete);
        };
      });
    }

    let modpackSettingsQuery = '';
    let modpackSortBy = 'name';
    const modpackSortOptions = {
      name: 'Sort by: Name',
      played: 'Sort by: Last played',
      time: 'Sort by: Play time',
    };

    function closeModpackSortMenu() {
      const wrap = document.getElementById('modpackSortWrap');
      const trigger = document.getElementById('modpackSortTrigger');
      if (!wrap || !trigger) return;
      wrap.classList.remove('open');
      trigger.setAttribute('aria-expanded', 'false');
    }

    function setModpackSort(value) {
      if (!modpackSortOptions[value]) return;
      modpackSortBy = value;
      const triggerName = document.getElementById('modpackSortTriggerName');
      if (triggerName) triggerName.textContent = modpackSortOptions[value];
      document.querySelectorAll('#modpackSortMenu .loader-item[data-sort]').forEach((el) => {
        const active = el.dataset.sort === value;
        el.classList.toggle('active', active);
        el.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      closeModpackSortMenu();
      renderModpackSettingsList();
    }

    function initModpackGridControls() {
      const search = document.getElementById('modpackSettingsSearch');
      const wrap = document.getElementById('modpackSortWrap');
      const trigger = document.getElementById('modpackSortTrigger');
      const menu = document.getElementById('modpackSortMenu');
      if (search) {
        search.addEventListener('input', () => {
          modpackSettingsQuery = search.value;
          renderModpackSettingsList();
        });
      }
      if (!wrap || !trigger || !menu) return;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        closeLoaderMenu();
        closeLauncherActionMenu();
        closeLogInstanceMenu();
        const isOpen = wrap.classList.toggle('open');
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      menu.querySelectorAll('.loader-item[data-sort]').forEach((item) => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          setModpackSort(item.dataset.sort);
        });
      });

      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target)) closeModpackSortMenu();
      });
    }

    async function selectModpack(id) {
      const result = await ipcRenderer.invoke('modpacks:select', id);
      if (!result.success) {
        showModal('Error', result.error || 'Could not select modpack', true);
        return;
      }
      syncSelectedFromModpack(result.modpack);
      await loadModpacks();
      closeModDetail();
      await refreshInstalledMods();
      showToast('Modpack selected', result.modpack.name);
    }

    function openCreateModpackModal() {
      openModpackFormModal();
    }

    function openImportModpackModal() {
      closeVersionPopup();
      const existing = document.getElementById('importModpackOverlay');
      if (existing) existing.remove();

      const overlay = document.createElement('div');
      overlay.className = 'modpack-form-overlay';
      overlay.id = 'importModpackOverlay';
      overlay.innerHTML = `
        <div class="modpack-form import-form">
          <div class="modpack-form-title">Import from Modrinth</div>
          <div class="modpack-form-desc">Copies the full instance into Cosmic — mods, worlds, options, resource packs, and configs.</div>
          <label for="importInstanceSearch">Search instances</label>
          <input id="importInstanceSearch" class="import-instance-search" type="search" placeholder="Search Modrinth instances..." autocomplete="off" spellcheck="false">
          <div class="import-instance-list" id="importInstanceList">
            <div class="import-instance-empty">Loading Modrinth instances...</div>
          </div>
          <div class="modpack-form-actions">
            <button type="button" class="mod-btn" id="importModpackClose">Close</button>
          </div>
        </div>
      `;
      document.body.appendChild(overlay);

      const listEl = document.getElementById('importInstanceList');
      const searchEl = document.getElementById('importInstanceSearch');
      let instances = [];

      const close = () => overlay.remove();
      document.getElementById('importModpackClose').onclick = close;
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) close();
      });

      function renderImportList(filter = '') {
        const query = filter.trim().toLowerCase();
        const filtered = instances.filter((item) => {
          const haystack = `${item.name} ${item.version || ''} ${item.loaderLabel || ''}`.toLowerCase();
          return !query || haystack.includes(query);
        });
        if (!filtered.length) {
          listEl.innerHTML = `<div class="import-instance-empty">${instances.length ? 'No instances match that search.' : 'No Modrinth instances found.'}</div>`;
          return;
        }
        listEl.innerHTML = filtered.map((item) => {
          const meta = [item.version || 'Unknown version', item.loaderLabel || 'Unknown loader'].join(' · ');
          const warning = item.supported ? '' : `<div class="import-instance-warning">Cosmic launches Vanilla and Fabric. Files will still be copied.</div>`;
          return `<div class="modpack-settings-item">
            <div class="modpack-settings-info">
              <div class="modpack-settings-name">${escapeHtml(item.name)}</div>
              <div class="modpack-settings-meta">${escapeHtml(meta)}</div>
              <div class="modpack-settings-playtime">${escapeHtml(formatPlayTime(item.playTimeMs))}</div>
              ${warning}
            </div>
            <div class="modpack-settings-actions">
              <button type="button" class="mod-btn install" data-import="${escapeHtml(item.id)}">Import</button>
            </div>
          </div>`;
        }).join('');

        listEl.querySelectorAll('[data-import]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-import');
            btn.disabled = true;
            btn.textContent = 'Importing...';
            listEl.querySelectorAll('[data-import]').forEach((other) => { other.disabled = true; });
            try {
              const result = await ipcRenderer.invoke('modpacks:importModrinth', id);
              if (!result.success) {
                showModal('Import failed', result.error || 'Could not import that instance', true);
                btn.disabled = false;
                btn.textContent = 'Import';
                listEl.querySelectorAll('[data-import]').forEach((other) => { other.disabled = false; });
                return;
              }
              overlay.remove();
              await selectModpack(result.pack.id);
              const extra = result.indexedMods ? ` · ${result.indexedMods} mods indexed` : '';
              showToast('Instance imported', `${result.pack.name}${extra}`);
            } catch (err) {
              showModal('Import failed', err.message, true);
              btn.disabled = false;
              btn.textContent = 'Import';
              listEl.querySelectorAll('[data-import]').forEach((other) => { other.disabled = false; });
            }
          });
        });
      }

      searchEl.addEventListener('input', () => renderImportList(searchEl.value));

      ipcRenderer.invoke('modpacks:listModrinth').then((result) => {
        if (!result.success) {
          listEl.innerHTML = `<div class="import-instance-empty">${escapeHtml(result.error || 'Could not read Modrinth instances.')}</div>`;
          return;
        }
        if (!result.foundApp) {
          listEl.innerHTML = '<div class="import-instance-empty">Modrinth App was not found on this computer.</div>';
          return;
        }
        instances = result.instances || [];
        renderImportList(searchEl.value);
      }).catch((err) => {
        listEl.innerHTML = `<div class="import-instance-empty">${escapeHtml(err.message)}</div>`;
      });

      searchEl.focus();
    }

    function openEditModpackModal(id) {
      const pack = modpacks.find(p => p.id === id);
      if (!pack || pack.isDefault) return;
      openModpackFormModal(pack);
    }

    function openModpackFormModal(existing) {
      closeVersionPopup();
      const overlay = document.createElement('div');
      overlay.className = 'modpack-form-overlay';

      const versions = availableVersions.length
        ? availableVersions
        : [{ id: resolvedLatestVersion || '1.21.4', type: 'release' }];
      const initialVersion = (existing && versions.some(v => v.id === existing.version))
        ? existing.version
        : versions[0].id;
      const initialLoader = existing && existing.loader === 'fabric' ? 'fabric' : 'vanilla';
      const checkIcon = VERSION_CHECK_ICON;

      const versionItems = versions.map(v => `
        <button type="button" class="loader-item${v.id === initialVersion ? ' active' : ''}" data-value="${v.id}" role="option" aria-selected="${v.id === initialVersion ? 'true' : 'false'}">
          <span class="loader-item-info">
            <span class="loader-item-name">${escapeHtml(v.id)}</span>
            <span class="loader-item-type">Release</span>
          </span>
          <span class="loader-item-actions">
            <span class="loader-check" aria-hidden="true">${checkIcon}</span>
          </span>
        </button>
      `).join('');

      overlay.innerHTML = `
        <div class="modpack-form">
          <div class="modpack-form-title">${existing ? 'Edit modpack' : 'Create modpack'}</div>
          <div class="modpack-form-desc">Each modpack gets its own Minecraft folder and mod list.</div>
          <label for="modpackNameInput">Name</label>
          <input id="modpackNameInput" type="text" maxlength="48" value="${existing ? escapeHtml(existing.name) : ''}" placeholder="My Fabric Pack">

          <label>Minecraft version</label>
          <div class="modpack-form-field" id="modpackVersionField">
            <div class="loader-wrap" id="modpackVersionWrap" data-value="${escapeHtml(initialVersion)}">
              <button type="button" class="loader-trigger" id="modpackVersionTrigger" aria-haspopup="listbox" aria-expanded="false">
                <div class="loader-trigger-info">
                  <span class="loader-trigger-name" id="modpackVersionTriggerName">${escapeHtml(initialVersion)}</span>
                  <span class="loader-trigger-type" id="modpackVersionTriggerType">Release</span>
                </div>
                <span class="loader-trigger-chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </button>
              <div class="loader-menu" id="modpackVersionMenu" role="listbox" aria-label="Minecraft versions">
                <div class="loader-list">${versionItems}</div>
              </div>
            </div>
          </div>

          <label>Loader</label>
          <div class="modpack-form-field" id="modpackLoaderField">
            <div class="loader-wrap" id="modpackLoaderWrap" data-value="${initialLoader}">
              <button type="button" class="loader-trigger" id="modpackLoaderTrigger" aria-haspopup="listbox" aria-expanded="false">
                <div class="loader-trigger-info">
                  <span class="loader-trigger-name" id="modpackLoaderTriggerName">${initialLoader === 'fabric' ? 'Fabric' : 'Vanilla'}</span>
                  <span class="loader-trigger-type" id="modpackLoaderTriggerType">${initialLoader === 'fabric' ? 'Mod loader' : 'Unmodified'}</span>
                </div>
                <span class="loader-trigger-chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </button>
              <div class="loader-menu" id="modpackLoaderMenu" role="listbox" aria-label="Mod loader options">
                <div class="loader-list">
                  <button type="button" class="loader-item${initialLoader !== 'fabric' ? ' active' : ''}" data-value="vanilla" role="option" aria-selected="${initialLoader !== 'fabric' ? 'true' : 'false'}">
                    <span class="loader-item-info">
                      <span class="loader-item-name">Vanilla</span>
                      <span class="loader-item-type">Unmodified</span>
                    </span>
                    <span class="loader-item-actions">
                      <span class="loader-check" aria-hidden="true">${checkIcon}</span>
                    </span>
                  </button>
                  <button type="button" class="loader-item${initialLoader === 'fabric' ? ' active' : ''}" data-value="fabric" role="option" aria-selected="${initialLoader === 'fabric' ? 'true' : 'false'}">
                    <span class="loader-item-info">
                      <span class="loader-item-name">Fabric</span>
                      <span class="loader-item-type">Mod loader</span>
                    </span>
                    <span class="loader-item-actions">
                      <span class="loader-check" aria-hidden="true">${checkIcon}</span>
                    </span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="modpack-form-actions">
            <button type="button" class="mod-btn" id="modpackFormCancel">Cancel</button>
            <button type="button" class="mod-btn install" id="modpackFormSave">${existing ? 'Save' : 'Create'}</button>
          </div>
        </div>
      `;
      document.body.appendChild(overlay);

      const versionWrap = document.getElementById('modpackVersionWrap');
      const loaderWrap = document.getElementById('modpackLoaderWrap');
      const versionField = document.getElementById('modpackVersionField');
      const loaderField = document.getElementById('modpackLoaderField');

      function closeFormDropdown(wrap, field) {
        if (!wrap) return;
        wrap.classList.remove('open');
        field?.classList.remove('open-above');
        wrap.querySelector('.loader-trigger')?.setAttribute('aria-expanded', 'false');
      }

      function closeAllFormDropdowns() {
        closeFormDropdown(versionWrap, versionField);
        closeFormDropdown(loaderWrap, loaderField);
      }

      function wireFormDropdown(wrap, field, onPick) {
        const trigger = wrap.querySelector('.loader-trigger');
        const menu = wrap.querySelector('.loader-menu');
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const willOpen = !wrap.classList.contains('open');
          closeAllFormDropdowns();
          if (willOpen) {
            wrap.classList.add('open');
            field.classList.add('open-above');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
        menu.querySelectorAll('.loader-item[data-value]').forEach(item => {
          item.addEventListener('click', (e) => {
            e.stopPropagation();
            onPick(item.dataset.value, item);
            closeFormDropdown(wrap, field);
          });
        });
      }

      wireFormDropdown(versionWrap, versionField, (value) => {
        versionWrap.dataset.value = value;
        document.getElementById('modpackVersionTriggerName').textContent = value;
        versionWrap.querySelectorAll('.loader-item').forEach(el => {
          const active = el.dataset.value === value;
          el.classList.toggle('active', active);
          el.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      });

      wireFormDropdown(loaderWrap, loaderField, (value) => {
        loaderWrap.dataset.value = value;
        document.getElementById('modpackLoaderTriggerName').textContent = value === 'fabric' ? 'Fabric' : 'Vanilla';
        document.getElementById('modpackLoaderTriggerType').textContent = value === 'fabric' ? 'Mod loader' : 'Unmodified';
        loaderWrap.querySelectorAll('.loader-item').forEach(el => {
          const active = el.dataset.value === value;
          el.classList.toggle('active', active);
          el.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      });

      document.getElementById('modpackFormCancel').onclick = () => overlay.remove();
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) overlay.remove();
        else closeAllFormDropdowns();
      });
      overlay.querySelector('.modpack-form').addEventListener('click', (e) => {
        if (!e.target.closest('.loader-wrap')) closeAllFormDropdowns();
      });

      document.getElementById('modpackFormSave').onclick = async () => {
        const name = document.getElementById('modpackNameInput').value.trim();
        const version = versionWrap.dataset.value;
        const loader = loaderWrap.dataset.value;
        const btn = document.getElementById('modpackFormSave');
        btn.disabled = true;
        try {
          const result = existing
            ? await ipcRenderer.invoke('modpacks:update', existing.id, { name, version, loader })
            : await ipcRenderer.invoke('modpacks:create', { name, version, loader });
          if (!result.success) {
            showModal('Error', result.error || 'Could not save modpack', true);
            btn.disabled = false;
            return;
          }
          overlay.remove();
          if (!existing) {
            await selectModpack(result.modpack.id);
          } else {
            await loadModpacks();
            await refreshInstalledMods();
          }
        } catch (err) {
          showModal('Error', err.message, true);
          btn.disabled = false;
        }
      };
      document.getElementById('modpackNameInput').focus();
    }

    async function deleteModpack(id) {
      const pack = modpacks.find(p => p.id === id);
      if (!pack || pack.isDefault) return;
      const confirmed = await showModal('Delete Modpack', `Delete "${pack.name}" and its Minecraft folder? This cannot be undone.`, true, true);
      if (!confirmed) return;
      const result = await ipcRenderer.invoke('modpacks:remove', id);
      if (!result.success) {
        showModal('Error', result.error || 'Could not delete modpack', true);
        return;
      }
      selectedModpackId = result.selectedId || 'default';
      await loadModpacks();
      await refreshInstalledMods();
    }

    function initSyncOptionsToggle() {
      const wrap = document.getElementById('syncOptionsToggle');
      if (!wrap) return;
      wrap.onclick = async () => {
        const next = wrap.dataset.enabled !== 'true';
        wrap.style.pointerEvents = 'none';
        try {
          const result = await ipcRenderer.invoke('modpacks:setSyncOptions', next);
          if (result.success) updateToggleUI(wrap, result.syncOptionsAcrossModpacks);
        } finally {
          wrap.style.pointerEvents = '';
        }
      };
    }

    function initLoaderSwitcher() {
      // Loader is managed per modpack now.
    }

    async function loadLoaderPreference() {
      await loadModpacks();
    }

    function needsModSyncForLaunch() {
      return false;
    }

    async function loadModsSyncState() {
      // Launch-time mod auto-update removed; updates are manual from the Mods page.
    }

    async function initLaunchState() {
      updateVersionUI();
      await loadVersions();
      await loadLoaderPreference();
      await loadModsSyncState();
      initSyncOptionsToggle();
      initModpackGridControls();
      renderModpackSettingsList();
    }

    function closeLoaderMenu() {
      // Loader UI removed; kept as no-op for existing call sites.
    }

/* ── LAUNCH OPTIONS ── */
    let launcherAction = '<%= launcherAction %>';
    let allowMultipleInstances = <%= allowMultipleInstances ? 'true' : 'false' %>;
    let gameRunning = false;

    const launcherActionOptions = {
      hide: { label: 'Hide launcher', type: 'Default' },
      exit: { label: 'Exit launcher', type: 'Quit app' },
      nothing: { label: 'Do nothing', type: 'Keep open' },
    };

    const PLAY_ICON_LAUNCH = '&#x25B6;';
    const PLAY_ICON_STOP = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2" fill="currentColor"></rect></svg>';

    function setLauncherAction(value) {
      if (!launcherActionOptions[value]) return;
      launcherAction = value;
      updateLauncherActionUI();
      closeLauncherActionMenu();
      ipcRenderer.invoke('setLauncherAction', launcherAction);
    }

    function updateLauncherActionUI() {
      const triggerName = document.getElementById('launcherActionTriggerName');
      const triggerType = document.getElementById('launcherActionTriggerType');
      const option = launcherActionOptions[launcherAction] || launcherActionOptions.hide;

      if (triggerName) triggerName.textContent = option.label;
      if (triggerType) triggerType.textContent = option.type;

      document.querySelectorAll('.loader-item[data-action]').forEach(el => {
        const isActive = el.dataset.action === launcherAction;
        el.classList.toggle('active', isActive);
        el.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    }

    function closeLauncherActionMenu() {
      const wrap = document.getElementById('launcherActionWrap');
      const trigger = document.getElementById('launcherActionTrigger');
      if (!wrap || !trigger) return;
      wrap.classList.remove('open');
      trigger.setAttribute('aria-expanded', 'false');
    }

    function initLauncherActionSwitcher() {
      const wrap = document.getElementById('launcherActionWrap');
      const trigger = document.getElementById('launcherActionTrigger');
      const menu = document.getElementById('launcherActionMenu');
      if (!wrap || !trigger || !menu) return;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        closeLoaderMenu();
        closeModpackSortMenu();
        const isOpen = wrap.classList.toggle('open');
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      menu.querySelectorAll('.loader-item[data-action]').forEach(item => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          setLauncherAction(item.dataset.action);
        });
      });

      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target)) closeLauncherActionMenu();
      });
    }

    function updateMultipleInstancesUI() {
      const toggle = document.getElementById('multipleInstancesToggle');
      if (!toggle) return;
      toggle.dataset.enabled = allowMultipleInstances ? 'true' : 'false';
      toggle.classList.toggle('on', allowMultipleInstances);
      const label = toggle.querySelector('span');
      if (label) label.textContent = allowMultipleInstances ? 'On' : 'Off';
    }

    function initMultipleInstancesToggle() {
      const toggle = document.getElementById('multipleInstancesToggle');
      if (!toggle) return;
      toggle.onclick = async () => {
        allowMultipleInstances = toggle.dataset.enabled !== 'true';
        updateMultipleInstancesUI();
        updatePlayButton();
        await ipcRenderer.invoke('setAllowMultipleInstances', allowMultipleInstances);
      };
    }

    function keepLauncherOpenOnLaunch() {
      return launcherAction === 'nothing';
    }

    function updatePlayButton() {
      const btn = document.getElementById('playBtn');
      const status = document.getElementById('playBtnStatus');
      const icon = document.getElementById('playBtnIcon');
      const dots = document.getElementById('playBtnDots');
      if (!btn || !status || !icon) return;

      const isStopping = btn.classList.contains('is-stopping');
      const isLaunching = btn.classList.contains('launching');
      const isStop = (gameRunning && !allowMultipleInstances) || isStopping;
      const showVersionPicker = !isStop && !isLaunching;

      btn.classList.toggle('stop-mode', isStop);

      if (!showVersionPicker && popupVisible) closeVersionPopup();

      if (dots) {
        dots.style.display = showVersionPicker ? '' : 'none';
        dots.setAttribute('aria-hidden', showVersionPicker ? 'false' : 'true');
      }

      if (btn.disabled) return;

      icon.innerHTML = isStop ? PLAY_ICON_STOP : PLAY_ICON_LAUNCH;
      status.textContent = isStop ? 'Stop' : 'Launch';
    }

    function setPlayButtonBusy(statusText) {
      const btn = document.getElementById('playBtn');
      const status = document.getElementById('playBtnStatus');
      const icon = document.getElementById('playBtnIcon');
      if (!btn || !status || !icon) return;

      btn.classList.remove('launching');
      void btn.offsetWidth;
      btn.classList.add('launching');
      icon.innerHTML = '<span class="btn-spinner"></span>';
      status.textContent = statusText;
      btn.disabled = true;
      updatePlayButton();
    }

    function resetPlayButtonIdle() {
      const btn = document.getElementById('playBtn');
      if (!btn) return;
      btn.classList.remove('launching');
      btn.disabled = false;
      updatePlayButton();
    }

    function finishLaunchUI({ hideLayout = true } = {}) {
      const layout = document.getElementById('layout');
      const overlay = document.getElementById('launchOverlay');
      const btn = document.getElementById('playBtn');

      if (hideLayout) {
        layout?.classList.remove('launching');
        overlay?.classList.remove('fading');
        if (window.resetStars) window.resetStars();
      }

      btn?.classList.remove('launching');
      if (btn) btn.disabled = false;
      updatePlayButton();
    }

    async function stopRunningGame() {
      const btn = document.getElementById('playBtn');
      const status = document.getElementById('playBtnStatus');
      const icon = document.getElementById('playBtnIcon');
      if (!btn) return;

      btn.classList.add('is-stopping');
      btn.disabled = true;
      updatePlayButton();
      status.textContent = 'Stopping...';
      icon.innerHTML = '<span class="btn-spinner"></span>';

      try {
        const result = await ipcRenderer.invoke('stopGame');
        if (result.success) {
          gameRunning = false;
          markActiveLaunchExited();
        } else {
          showModal('Stop Failed', result.error || 'Could not stop the game.', true);
        }
      } catch (err) {
        showModal('Stop Failed', err.message, true);
      } finally {
        btn.classList.remove('is-stopping');
        btn.disabled = false;
        updatePlayButton();
      }
    }

    async function loadLaunchOptions() {
      try {
        const opts = await ipcRenderer.invoke('getLaunchOptions');
        if (opts) {
          if (launcherActionOptions[opts.launcherAction]) launcherAction = opts.launcherAction;
          allowMultipleInstances = !!opts.allowMultipleInstances;
        }
        updateLauncherActionUI();
        updateMultipleInstancesUI();
        gameRunning = await ipcRenderer.invoke('isGameRunning');
        updatePlayButton();
      } catch (e) {
        console.log('Could not load launch options:', e);
      }
    }

/* ── SETTINGS PANEL ── */
    let activeLogFilter = 'all';
    let logInstances = [];
    let logInstanceCounter = 0;
    let activeLogInstanceId = null;
    let activeLaunchInstanceId = null;
    let modsSubTabsAnimated = false;
    let modsInstalledAnimated = false;
    let modsBrowseAnimated = false;

    function animateModsSubTabs() {
      if (modsSubTabsAnimated) return;
      modsSubTabsAnimated = true;
      document.querySelector('#settingsTabMods .mods-sub-tabs')?.classList.add('animate-in');
    }

    function animateModsInstalledView() {
      if (modsInstalledAnimated) return;
      modsInstalledAnimated = true;
      animateModsSubTabs();
      const view = document.getElementById('modsViewInstalled');
      if (!view) return;
      view.querySelectorAll('.mod-card, .mods-empty').forEach((el, i) => {
        el.style.setProperty('--stagger', i);
        el.classList.add('animate-in');
      });
    }

    function animateModsBrowseView() {
      if (modsBrowseAnimated) return;
      modsBrowseAnimated = true;
      animateModsSubTabs();
      document.querySelector('#modsViewBrowse .mod-search-panel')?.classList.add('animate-in');
      document.querySelectorAll('#modsViewBrowse .mods-empty').forEach(el => {
        el.classList.add('animate-in');
      });
    }

    function animateActiveModsSubview() {
      const installedView = document.getElementById('modsViewInstalled');
      if (installedView?.classList.contains('active')) animateModsInstalledView();
      else animateModsBrowseView();
    }

    function retriggerSettingsAnimations(tabEl) {
      if (!tabEl) return;
      if (tabEl.id === 'settingsTabMods') {
        animateActiveModsSubview();
        return;
      }
      const animated = tabEl.querySelectorAll('.settings-section, .log-panel');
      animated.forEach(el => {
        el.style.animation = 'none';
        void el.offsetHeight;
        el.style.animation = '';
      });
    }

    function openSettings() {
      document.getElementById('settingsOverlay').classList.add('show');
      const activeTab = document.querySelector('.settings-tab-content.active');
      retriggerSettingsAnimations(activeTab);
    }

    function closeSettings() {
      closeLoaderMenu();
      closeLauncherActionMenu();
      closeModpackSortMenu();
      closeLogInstanceMenu();
      document.getElementById('settingsOverlay').classList.remove('show');
    }

    function switchSettingsTab(tab) {
      closeModpackSortMenu();
      document.querySelectorAll('.settings-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.settings-tab-content').forEach(c => c.classList.remove('active'));
      document.querySelector(`.settings-tab[data-tab="${tab}"]`).classList.add('active');
      let tabEl;
      if (tab === 'launch') {
        tabEl = document.getElementById('settingsTabLaunch');
      } else if (tab === 'modpacks') {
        tabEl = document.getElementById('settingsTabModpacks');
      } else if (tab === 'appearance') {
        tabEl = document.getElementById('settingsTabAppearance');
      } else if (tab === 'mods') {
        tabEl = document.getElementById('settingsTabMods');
      } else if (tab === 'logs') {
        tabEl = document.getElementById('settingsTabLogs');
      }
      if (tabEl) {
        tabEl.classList.add('active');
        if (tab === 'mods') {
          refreshInstalledMods().then(() => animateActiveModsSubview());
        } else {
          if (tab === 'modpacks') renderModpackSettingsList();
          retriggerSettingsAnimations(tabEl);
        }
      }
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLoaderMenu();
        closeLauncherActionMenu();
        closeModpackSortMenu();
        closeLogInstanceMenu();
        const overlay = document.getElementById('settingsOverlay');
        if (overlay && overlay.classList.contains('show')) {
          closeSettings();
        }
      }
    });

    let modSearchLoading = false;
    let installedModIds = new Set();

    async function refreshInstalledModIds() {
      installedModIds = new Set();
      try {
        const result = await ipcRenderer.invoke('mods:list');
        if (result.success && result.mods) {
          Object.keys(result.mods).forEach(id => installedModIds.add(id));
        }
      } catch (e) {
        console.error('Failed to refresh installed mod ids:', e);
      }
      return installedModIds;
    }

    function updateBrowseInstallButtons() {
      document.querySelectorAll('#modSearchResults .mod-btn.install[data-project]').forEach(btn => {
        const projectId = btn.dataset.project;
        const isInstalled = installedModIds.has(projectId);
        btn.classList.toggle('installed', isInstalled);
        btn.disabled = isInstalled;
        btn.textContent = isInstalled ? 'Installed' : 'Install';
        if (isInstalled) {
          btn.onclick = null;
        } else if (!btn.onclick) {
          btn.onclick = (e) => installMod(e, projectId, btn.dataset.title);
        }
      });
    }

    function browseInstallButtonHtml(projectId, title, isInstalled) {
      return `<button class="mod-btn install${isInstalled ? ' installed' : ''}" data-project="${projectId}" data-title="${title.replace(/"/g, '&quot;')}"${isInstalled ? ' disabled' : ''}>${isInstalled ? 'Installed' : 'Install'}</button>`;
    }

    function updateModSearchClear() {
      const input = document.getElementById('modSearchInput');
      const clearBtn = document.getElementById('modSearchClear');
      if (!input || !clearBtn) return;
      clearBtn.classList.toggle('visible', input.value.trim().length > 0);
    }

    function setModSearchLoading(loading) {
      modSearchLoading = loading;
      const submitBtn = document.getElementById('modSearchSubmit');
      const submitIcon = submitBtn ? submitBtn.querySelector('.mod-search-submit-icon') : null;
      const submitLabel = submitBtn ? submitBtn.querySelector('.mod-search-submit-label') : null;
      const input = document.getElementById('modSearchInput');
      if (submitBtn) submitBtn.disabled = loading;
      if (submitBtn) submitBtn.classList.toggle('loading', loading);
      if (input) input.disabled = loading;
      if (submitIcon) submitIcon.innerHTML = loading ? uiIcons.loader : uiIcons.search;
      if (submitLabel) submitLabel.textContent = loading ? 'Searching' : 'Search';
    }

    function clearModSearch() {
      const input = document.getElementById('modSearchInput');
      if (!input || modSearchLoading) return;
      input.value = '';
      updateModSearchClear();
      input.focus();
    }

    function initModSearch() {
      const input = document.getElementById('modSearchInput');
      const clearBtn = document.getElementById('modSearchClear');
      if (!input) return;

      input.addEventListener('input', updateModSearchClear);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          searchMods();
        } else if (e.key === 'Escape') {
          clearModSearch();
        }
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', (e) => {
          e.preventDefault();
          clearModSearch();
        });
      }

      updateModSearchClear();
      initModSearchSticky();
    }

    function initModSearchSticky() {
      return;
    }

    async function searchMods() {
      const input = document.getElementById('modSearchInput');
      const resultsDiv = document.getElementById('modSearchResults');
      const query = input.value.trim();
      if (!query || modSearchLoading) return;

      setModSearchLoading(true);
      resultsDiv.innerHTML = '<div class="mods-empty">Searching Modrinth...</div>';

      try {
        const result = await ipcRenderer.invoke('mods:search', query);
        if (!result.success) {
          resultsDiv.innerHTML = `<div class="mods-empty" style="color:#ff6666">Error: ${result.error}</div>`;
          return;
        }

        if (!result.results || result.results.length === 0) {
          resultsDiv.innerHTML = '<div class="mods-empty">No mods found for that search.<br>Try different keywords.</div>';
          return;
        }

        await refreshInstalledModIds();
        resultsDiv.innerHTML = '';
        for (const mod of result.results) {
          const projectId = mod.project_id;
          const isInstalled = installedModIds.has(projectId);
          const card = document.createElement('div');
          card.className = 'mod-card';
          card.dataset.project = projectId;
          card.onclick = () => openModDetail(projectId, 'browse');
          
          card.innerHTML = `
            <div class="mod-card-top">
              ${modIconTag(mod.icon_url)}
              <div class="mod-info-main">
                <div class="mod-title" title="${escapeHtml(mod.title)}">${escapeHtml(mod.title)}</div>
                <div class="mod-author-tag">${escapeHtml(mod.author || 'Modrinth')}</div>
              </div>
            </div>
            <div class="mod-actions" onclick="event.stopPropagation()">
              ${browseInstallButtonHtml(projectId, mod.title, isInstalled)}
            </div>
          `;

          if (!isInstalled) {
            card.querySelector('.mod-btn').onclick = (e) => {
              e.stopPropagation();
              installMod(e, projectId, mod.title);
            };
          }
          resultsDiv.appendChild(card);
        }
        initModIconImages(resultsDiv);
      } catch (err) {
        resultsDiv.innerHTML = `<div class="mods-empty" style="color:#ff6666">Search failed: ${err.message}</div>`;
      } finally {
        setModSearchLoading(false);
      }
    }

    async function installMod(e, projectId, title) {
      const btn = e.currentTarget;
      btn.disabled = true;
      btn.textContent = 'Working...';

      try {
        const result = await ipcRenderer.invoke('mods:install', projectId, null, getEffectiveGameVersion(), 'fabric');
        if (result.success) {
          const data = result.data || {};
          let msg = 'Installed successfully';
          if (data.installedDeps && data.installedDeps.length > 0) {
            msg += '. Auto-installed ' + data.installedDeps.length + ' dependency(ies)';
          }
          btn.textContent = 'Installed';
          btn.classList.add('installed');
          installedModIds.add(projectId);
          updateBrowseInstallButtons();
          await refreshInstalledMods();
          if (data.conflicts && data.conflicts.length > 0) {
            const conflictMsg = data.conflicts.map(c => c.reason).join('<br>');
            showModal('Compatibility Warnings', 'Mod installed but has conflicts:<br><br>' + conflictMsg, true);
          } else if (data.resolved && data.resolved.length > 0) {
            const resolvedMsg = data.resolved.map(r => `${r.replaced} → v${r.newVersion} (required by ${r.requiredBy})`).join('<br>');
            showToast('Conflicts resolved', resolvedMsg);
          } else if (data.installedDeps && data.installedDeps.length > 0) {
            showToast('Dependencies installed', data.installedDeps.map(d => d.title).join(', '));
          }
        } else {
          btn.textContent = 'Failed';
          showModal('Install Failed', result.error, true);
          setTimeout(() => { btn.textContent = 'Install'; btn.disabled = false; }, 2000);
        }
      } catch (err) {
        btn.textContent = 'Error';
        showModal('Install Error', err.message, true);
        setTimeout(() => { btn.textContent = 'Install'; btn.disabled = false; }, 2000);
      }
    }

    async function refreshInstalledMods() {
      const grid = document.getElementById('installedModsList');
      if(!grid) return;
      
      try {
        const result = await ipcRenderer.invoke('mods:list');
        if (!result.success) {
          grid.innerHTML = `<div class="mods-empty">Error loading installed mods</div>`;
          return;
        }

        const mods = result.mods;
        window.__installedModsCache = mods;
        const entries = Object.entries(mods);

        if (entries.length === 0) {
          grid.innerHTML = '<div class="mods-empty">No mods currently installed.<br>Head over to Browse to find some!</div>';
          await refreshInstalledModIds();
          updateBrowseInstallButtons();
          return;
        }

        grid.innerHTML = entries.map(([id, mod]) => renderModCard(id, mod)).join('');
        await refreshInstalledModIds();
        updateBrowseInstallButtons();
        initModHandlers();
        initSettingsIcons(grid);
        initModIconImages(grid);
      } catch (err) {
        grid.innerHTML = `<div class="mods-empty" style="color:#ff6666">${err.message}</div>`;
      }
    }

    async function openModsFolder() {
      if (window.ipcRenderer) {
        window.ipcRenderer.invoke('openModsFolder');
      }
    }

    async function openInstanceFolder() {
      if (window.ipcRenderer) {
        window.ipcRenderer.invoke('openInstanceFolder');
      }
    }

/* ── MODPACK POPUP ── */
    let selectedVersion = '<%= selectedVersion %>';
    let popupVisible = false;
    let availableVersions = [];
    let versionSearchQuery = '';

    const VERSION_CHECK_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

    function getEffectiveGameVersion() {
      const pack = getSelectedModpack();
      if (!pack) return selectedVersion;
      if (pack.version === 'latest') return resolvedLatestVersion || selectedVersion;
      return pack.version;
    }

    function getFilteredModpacks() {
      const query = versionSearchQuery.trim().toLowerCase();
      if (!query) return modpacks;
      return modpacks.filter(p =>
        p.name.toLowerCase().includes(query) ||
        String(p.version).toLowerCase().includes(query) ||
        String(p.loader).toLowerCase().includes(query)
      );
    }

    function openVersionPopup() {
      const btn = document.getElementById('playBtn');
      if (btn?.classList.contains('launching') || btn?.classList.contains('stop-mode')) return;
      popupVisible = true;
      document.getElementById('versionPopup').classList.add('show');
      renderVersionList();
      requestAnimationFrame(() => {
        document.getElementById('versionSearchInput')?.focus();
      });
    }

    function closeVersionPopup() {
      popupVisible = false;
      document.getElementById('versionPopup').classList.remove('show');
      versionSearchQuery = '';
      const searchInput = document.getElementById('versionSearchInput');
      if (searchInput) searchInput.value = '';
      renderVersionList();
    }

    function handlePopupBackdropClick(event) {
      if (event.target === document.getElementById('versionPopup')) closeVersionPopup();
    }

    async function loadVersions() {
      try {
        const result = await ipcRenderer.invoke('getAvailableVersions');
        if (result.success) {
          availableVersions = result.versions.filter(v => v.type === 'release').slice(0, 40);
          resolvedLatestVersion = availableVersions[0]?.id || null;
        }
      } catch (err) {
        console.error('Failed to load versions:', err);
        availableVersions = [
          { id: '1.21.4', type: 'release' },
          { id: '1.20.4', type: 'release' },
          { id: '1.20.1', type: 'release' },
          { id: '1.19.4', type: 'release' },
          { id: '1.18.2', type: 'release' }
        ];
        resolvedLatestVersion = availableVersions[0].id;
      }

      try {
        const resolved = await ipcRenderer.invoke('modpacks:resolveVersion', 'latest');
        if (resolved.success) resolvedLatestVersion = resolved.versionId;
      } catch (e) {}

      syncSelectedFromModpack(getSelectedModpack());
      updateVersionUI();
      await refreshInstalledMods();
    }

    function updateVersionUI() {
      const pack = getSelectedModpack();
      const labelText = document.getElementById('versionLabelText');
      if (labelText) labelText.textContent = pack ? pack.name : 'Latest';
      const playtimeLabel = document.getElementById('playtimeLabel');
      if (playtimeLabel) {
        playtimeLabel.dataset.playtimeId = pack ? pack.id : '';
        playtimeLabel.textContent = formatPlayTime(pack?.playTimeMs);
      }
      renderVersionList();
      renderModpackSettingsList();
    }

    function renderVersionList() {
      const list = document.getElementById('versionList');
      if (!list) return;

      const filtered = getFilteredModpacks();
      if (filtered.length === 0) {
        list.innerHTML = '<div class="version-popup-empty">No modpacks match your search.</div>';
        return;
      }

      list.innerHTML = filtered.map(pack => {
        const isActive = pack.id === selectedModpackId;
        return `<button type="button" class="loader-item${isActive ? ' active' : ''}" data-modpack="${pack.id}" role="option" aria-selected="${isActive ? 'true' : 'false'}">
          <span class="loader-item-info">
            <span class="loader-item-name">${escapeHtml(pack.name)}</span>
            <span class="loader-item-type">${escapeHtml(formatModpackMeta(pack))}</span>
            <span class="loader-item-playtime" data-playtime-id="${pack.id}">${escapeHtml(formatPlayTime(pack.playTimeMs))}</span>
          </span>
          <span class="loader-item-actions">
            <span class="loader-check" aria-hidden="true">${VERSION_CHECK_ICON}</span>
          </span>
        </button>`;
      }).join('');

      list.querySelectorAll('.loader-item[data-modpack]').forEach(item => {
        item.addEventListener('click', async (e) => {
          e.stopPropagation();
          if (item.dataset.modpack === selectedModpackId) {
            closeVersionPopup();
            return;
          }
          await selectModpack(item.dataset.modpack);
          setTimeout(closeVersionPopup, 120);
        });
      });
    }

    function initVersionSearch() {
      const input = document.getElementById('versionSearchInput');
      if (!input) return;
      input.addEventListener('input', () => {
        versionSearchQuery = input.value;
        renderVersionList();
      });
      input.addEventListener('keydown', (e) => {
        e.stopPropagation();
      });
    }

    async function updateAllMods() {
      const btn = document.getElementById('updateModsBtn');
      const gameVersion = getEffectiveGameVersion();
      const loader = selectedLoader === 'fabric' ? 'fabric' : 'vanilla';
      if (loader !== 'fabric') {
        showToast('Nothing to update', 'Vanilla modpacks do not use Modrinth mods.');
        return;
      }
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Updating…';
      }
      try {
        const result = await ipcRenderer.invoke('mods:autoUpdateForVersion', gameVersion, 'fabric');
        if (!result.success) {
          showModal('Update Failed', result.error || 'Could not update mods.', true);
          return;
        }
        let msg = '';
        if (result.updated?.length) msg += result.updated.length + ' updated';
        if (result.installedDeps?.length) msg += (msg ? ', ' : '') + result.installedDeps.length + ' deps';
        if (result.failed?.length) msg += (msg ? ', ' : '') + result.failed.length + ' failed';
        showToast('Mod update finished', msg || 'All mods are up to date');
        await refreshInstalledMods();
        if (currentModDetail?.project?.id || currentModDetail?.project?.project_id) {
          await openModDetail(currentModDetail.project.id || currentModDetail.project.project_id);
        }
      } catch (err) {
        showModal('Update Failed', err.message, true);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Update mods';
        }
      }
    }

    function switchModsTab(tab) {
      document.querySelectorAll('.mods-sub-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.mods-view').forEach(v => v.classList.remove('active'));

      if (tab === 'installed') {
        document.getElementById('modsTabInstalledBtn')?.classList.add('active');
        document.getElementById('modsViewInstalled')?.classList.add('active');
        document.getElementById('modSearchPanel')?.classList.remove('is-stuck');
        refreshInstalledMods().then(() => animateModsInstalledView());
      } else if (tab === 'browse') {
        document.getElementById('modsTabBrowseBtn')?.classList.add('active');
        document.getElementById('modsViewBrowse')?.classList.add('active');
        if (typeof animateModsBrowseView === 'function') animateModsBrowseView();
        else animateActiveModsSubview();
      } else if (tab === 'detail') {
        document.getElementById('modsViewDetail')?.classList.add('active');
      }
      document.getElementById('modsSubTabs')?.classList.toggle('hidden-detail', tab === 'detail');
    }

    function getActiveModLoaders() {
      return selectedLoader === 'fabric' ? ['fabric'] : [];
    }

    function filterVersionsForLoader(versions, loaders) {
      if (!Array.isArray(versions)) return [];
      if (!loaders.length) return versions;
      return versions.filter(v => {
        const versionLoaders = (v.loaders || []).map(l => String(l).toLowerCase());
        return loaders.some(l => versionLoaders.includes(String(l).toLowerCase()));
      });
    }

    async function openModDetail(projectId, returnTab) {
      if (!projectId) return;
      modDetailReturnTab = returnTab || (document.getElementById('modsViewBrowse')?.classList.contains('active') ? 'browse' : 'installed');
      switchModsTab('detail');
      const content = document.getElementById('modDetailContent');
      if (content) content.innerHTML = '<div class="mods-empty">Loading mod…</div>';

      try {
        const loaders = getActiveModLoaders();
        const [projectResult, versionsResult] = await Promise.all([
          ipcRenderer.invoke('mods:getProject', projectId),
          ipcRenderer.invoke('mods:getVersions', projectId, [], loaders),
        ]);
        if (!projectResult.success) {
          content.innerHTML = `<div class="mods-empty" style="color:#ff6666">${escapeHtml(projectResult.error || 'Failed to load mod')}</div>`;
          return;
        }
        const versions = filterVersionsForLoader(
          versionsResult.success ? (versionsResult.versions || []) : [],
          loaders
        );
        currentModDetail = {
          project: projectResult.project,
          versions,
          tab: 'overview',
        };
        renderModDetail();
      } catch (err) {
        content.innerHTML = `<div class="mods-empty" style="color:#ff6666">${escapeHtml(err.message)}</div>`;
      }
    }

    function closeModDetail() {
      currentModDetail = null;
      switchModsTab(modDetailReturnTab || 'browse');
    }

    function renderModDetail() {
      const content = document.getElementById('modDetailContent');
      if (!content || !currentModDetail) return;
      const project = currentModDetail.project;
      const projectId = project.id || project.project_id;
      const isInstalled = installedModIds.has(projectId);
      const body = project.body || project.description || 'No description provided.';
      const categories = (project.categories || []).slice(0, 8).join(' · ');
      const downloads = project.downloads != null ? Number(project.downloads).toLocaleString() : '—';
      const followers = project.followers != null ? Number(project.followers).toLocaleString() : '—';

      content.innerHTML = `
        <div class="mod-detail-header">
          ${modIconTag(project.icon_url)}
          <div>
            <div class="mod-detail-title">${escapeHtml(project.title)}</div>
            <div class="mod-detail-meta">${escapeHtml(categories || 'Modrinth mod')}<br>${downloads} downloads · ${followers} followers${isInstalled ? ' · Installed' : ''}</div>
          </div>
        </div>
        <div class="mod-detail-tabs">
          <button type="button" class="mod-detail-tab${currentModDetail.tab === 'overview' ? ' active' : ''}" data-tab="overview">Overview</button>
          <button type="button" class="mod-detail-tab${currentModDetail.tab === 'versions' ? ' active' : ''}" data-tab="versions">Versions</button>
        </div>
        <div id="modDetailPane"></div>
      `;

      const icon = content.querySelector('.mod-icon');
      if (icon) {
        icon.classList.add('mod-detail-icon');
        setModIconImg(icon, project.icon_url || '');
      }

      content.querySelectorAll('.mod-detail-tab').forEach(tabBtn => {
        tabBtn.onclick = () => {
          currentModDetail.tab = tabBtn.dataset.tab;
          renderModDetail();
        };
      });

      const pane = document.getElementById('modDetailPane');
      if (currentModDetail.tab === 'overview') {
        pane.innerHTML = `<div class="mod-detail-body">${renderMarkdown(body)}</div>`;
        bindMarkdownLinks(pane);
      } else {
        renderModVersionsPane(pane, project, projectId, isInstalled);
      }
    }

    function normalizeVersionChannel(version) {
      const type = String(version?.version_type || '').toLowerCase();
      if (type === 'release' || type === 'beta' || type === 'alpha') return type;
      const num = String(version?.version_number || version?.name || '').toLowerCase();
      if (num.includes('alpha')) return 'alpha';
      if (num.includes('beta') || num.includes('pre') || num.includes('rc')) return 'beta';
      return 'release';
    }

    function getVersionFilterState(allVersions) {
      const packMc = getEffectiveGameVersion();
      if (!currentModDetail.versionFilters) {
        const hasPackMatch = !!packMc && allVersions.some(v => (v.game_versions || []).includes(packMc));
        currentModDetail.versionFilters = {
          channel: 'all',
          gameVersion: hasPackMatch ? packMc : 'all',
        };
      }
      return currentModDetail.versionFilters;
    }

    function collectGameVersions(versions) {
      const set = new Set();
      versions.forEach(v => (v.game_versions || []).forEach(gv => set.add(gv)));
      return Array.from(set).sort((a, b) => {
        const pa = a.split('.').map(n => parseInt(n, 10) || 0);
        const pb = b.split('.').map(n => parseInt(n, 10) || 0);
        for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
          const diff = (pb[i] || 0) - (pa[i] || 0);
          if (diff) return diff;
        }
        return b.localeCompare(a);
      });
    }

    function applyVersionFilters(versions, filters) {
      return versions.filter(v => {
        const channel = normalizeVersionChannel(v);
        if (filters.channel !== 'all' && channel !== filters.channel) return false;
        if (filters.gameVersion !== 'all' && !(v.game_versions || []).includes(filters.gameVersion)) return false;
        return true;
      });
    }

    function renderChannelTag(channel) {
      const label = channel === 'release' ? 'Release' : channel === 'beta' ? 'Beta' : 'Alpha';
      return `<span class="mod-tag channel-${channel}">${label}</span>`;
    }

    function renderGameVersionTags(gameVersions) {
      const list = gameVersions || [];
      const shown = list.slice(0, 4);
      const extra = list.length - shown.length;
      return shown.map(gv => `<span class="mod-tag mc">${escapeHtml(gv)}</span>`).join('')
        + (extra > 0 ? `<span class="mod-tag mc">+${extra}</span>` : '');
    }

    function renderModVersionsPane(pane, project, projectId, isInstalled) {
      const allVersions = filterVersionsForLoader(currentModDetail.versions || [], getActiveModLoaders());
      if (!allVersions.length) {
        const loaderLabel = selectedLoader === 'fabric' ? 'Fabric' : selectedLoader;
        pane.innerHTML = `<div class="mods-empty">No ${escapeHtml(loaderLabel)} versions found for this mod.</div>`;
        return;
      }

      const filters = getVersionFilterState(allVersions);
      const gameVersions = collectGameVersions(allVersions);
      const filtered = applyVersionFilters(allVersions, filters);
      const installedVersionId = (Object.values(window.__installedModsCache || {}).find(m => m.projectId === projectId) || {}).installedVersion;
      const packMc = getEffectiveGameVersion();

      const channelChips = ['all', 'release', 'beta', 'alpha'].map(ch => {
        const label = ch === 'all' ? 'All' : ch[0].toUpperCase() + ch.slice(1);
        return `<button type="button" class="mod-version-chip${filters.channel === ch ? ' active' : ''}" data-channel="${ch}">${label}</button>`;
      }).join('');

      const gameOptions = [
        `<option value="all"${filters.gameVersion === 'all' ? ' selected' : ''}>All MC versions</option>`,
        ...gameVersions.map(gv => {
          const packHint = gv === packMc ? ' (pack)' : '';
          return `<option value="${escapeHtml(gv)}"${filters.gameVersion === gv ? ' selected' : ''}>${escapeHtml(gv)}${packHint}</option>`;
        }),
      ].join('');

      pane.innerHTML = `
        <div class="mod-version-toolbar">
          <div class="mod-version-filters">
            <span class="mod-version-filter-label">Channel</span>
            ${channelChips}
          </div>
          <div class="mod-version-filters">
            <span class="mod-version-filter-label">Minecraft</span>
            <select class="mod-version-select" id="modVersionGameFilter">${gameOptions}</select>
            ${packMc ? `<button type="button" class="mod-version-chip${filters.gameVersion === packMc ? ' active' : ''}" id="modVersionPackChip">Pack: ${escapeHtml(packMc)}</button>` : ''}
            <span class="mod-version-count">${filtered.length} of ${allVersions.length}</span>
          </div>
        </div>
        <div class="mod-version-list" id="modVersionList"></div>
      `;

      const list = document.getElementById('modVersionList');
      if (!filtered.length) {
        list.innerHTML = '<div class="mods-empty" style="padding:36px 16px">No versions match these filters.</div>';
      } else {
        list.innerHTML = filtered.map(v => {
          const channel = normalizeVersionChannel(v);
          const date = v.date_published ? new Date(v.date_published).toLocaleDateString() : '';
          const isCurrent = installedVersionId && v.id === installedVersionId;
          const activeLoaders = getActiveModLoaders();
          const loaders = (v.loaders || []).filter(l =>
            !activeLoaders.length || activeLoaders.includes(String(l).toLowerCase())
          );
          const loaderTags = (loaders.length ? loaders : (v.loaders || []).slice(0, 1))
            .map(l => `<span class="mod-tag loader">${escapeHtml(l)}</span>`).join('');
          return `<div class="mod-version-row${isCurrent ? ' current' : ''}">
            <div class="mod-version-info">
              <div class="mod-version-top">
                <div class="mod-version-name">${escapeHtml(v.version_number || v.name || 'Unknown')}</div>
                ${isCurrent ? '<span class="mod-tag current">Current</span>' : ''}
              </div>
              <div class="mod-version-tags">
                ${renderChannelTag(channel)}
                ${loaderTags}
                ${renderGameVersionTags(v.game_versions)}
              </div>
              <div class="mod-version-meta">${date ? escapeHtml(date) : ''}${v.name && v.name !== v.version_number ? ' · ' + escapeHtml(v.name) : ''}</div>
            </div>
            <button type="button" class="mod-btn install${isCurrent ? ' installed' : ''}" data-version="${v.id}" ${isCurrent ? 'disabled' : ''}>${isCurrent ? 'Installed' : (isInstalled ? 'Switch' : 'Install')}</button>
          </div>`;
        }).join('');
      }

      pane.querySelectorAll('[data-channel]').forEach(btn => {
        btn.onclick = () => {
          currentModDetail.versionFilters.channel = btn.dataset.channel;
          renderModDetail();
        };
      });

      const gameSelect = document.getElementById('modVersionGameFilter');
      if (gameSelect) {
        gameSelect.onchange = () => {
          currentModDetail.versionFilters.gameVersion = gameSelect.value;
          renderModDetail();
        };
      }

      const packChip = document.getElementById('modVersionPackChip');
      if (packChip && packMc) {
        packChip.onclick = () => {
          currentModDetail.versionFilters.gameVersion =
            currentModDetail.versionFilters.gameVersion === packMc ? 'all' : packMc;
          renderModDetail();
        };
      }

      list.querySelectorAll('[data-version]:not(:disabled)').forEach(btn => {
        const label = isInstalled ? 'Switch' : 'Install';
        btn.onclick = (e) => installModVersion(e, projectId, project.title, btn.dataset.version, label);
      });
    }

    async function installModVersion(e, projectId, title, versionId, actionLabel = 'Install') {
      const btn = e.currentTarget;
      btn.disabled = true;
      btn.textContent = 'Working…';
      try {
        if (selectedLoader !== 'fabric') {
          showModal('Fabric Required', 'Switch to a Fabric modpack to install mods.', true);
          btn.disabled = false;
          btn.textContent = actionLabel;
          return;
        }
        const gameVersion = getEffectiveGameVersion();
        const result = await ipcRenderer.invoke('mods:install', projectId, versionId, gameVersion, 'fabric');
        if (result.success) {
          btn.textContent = 'Installed';
          btn.classList.add('installed');
          installedModIds.add(projectId);
          await refreshInstalledMods();
          showToast(actionLabel === 'Switch' ? 'Version switched' : 'Installed', title);
          if (currentModDetail) renderModDetail();
        } else {
          btn.textContent = actionLabel;
          btn.disabled = false;
          showModal('Install Failed', result.error, true);
        }
      } catch (err) {
        btn.textContent = actionLabel;
        btn.disabled = false;
        showModal('Install Error', err.message, true);
      }
    }

    function showToast(title, message) {
      const toast = document.createElement('div');
      toast.style.cssText = 'position:fixed;top:64px;right:20px;background:rgba(15,15,30,0.95);border:1px solid var(--accent);border-radius:8px;padding:12px 18px;z-index:10000;animation:fadeIn .3s;max-width:350px;';
      toast.innerHTML = `<div style="font-weight:600;color:var(--accent);margin-bottom:4px;">${title}</div><div style="color:#aaa;font-size:13px;">${message}</div>`;
      document.body.appendChild(toast);
      setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity .5s'; }, 3000);
      setTimeout(() => toast.remove(), 3500);
    }

    initLaunchState();
    initVersionSearch();
    loadLaunchOptions();
    initThemePicker();
    initOnboarding();
    initLoaderSwitcher();
    initLauncherActionSwitcher();
    initMultipleInstancesToggle();
    initLogInstanceSwitcher();
    initModSearch();
    refreshInstalledModIds();
    initModIconImages();
    initSettingsIcons();
    initModHandlers();
    updateLogEmptyState();

    if (window.ipcRenderer) {
      window.ipcRenderer.on('triggerOpenAnimation', () => {
        if (window.triggerOpenAnimation) window.triggerOpenAnimation();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && popupVisible) closeVersionPopup();
    });

    /* ── WIRE UP BUTTONS ── */
    document.getElementById('playBtnDots').addEventListener('click', function (e) {
      e.stopPropagation();
      const btn = document.getElementById('playBtn');
      if (btn?.classList.contains('stop-mode') || btn?.classList.contains('launching')) return;
      popupVisible ? closeVersionPopup() : openVersionPopup();
    });

    document.getElementById('playBtnLabel').addEventListener('click', function (e) {
      e.stopPropagation();
      play();
    });

    /* ── PLAY ── */
    async function play() {
      const btn = document.getElementById('playBtn');
      if (btn.disabled) return;

      if (btn.classList.contains('stop-mode')) {
        await stopRunningGame();
        return;
      }

      setPlayButtonBusy('Launching');

      const rect = btn.getBoundingClientRect();
      window.spawnParticles(rect.left + rect.width / 2, rect.top + rect.height / 2);
      const keepOpen = keepLauncherOpenOnLaunch();
      const layout = document.getElementById('layout');
      const overlay = document.getElementById('launchOverlay');

      const launchSound = document.getElementById('launchSound');
      if (launchSound) {
        launchSound.currentTime = 0;
        launchSound.volume = 0.4;
        launchSound.play().catch(() => {});
      }

      if (!keepOpen) {
        layout.classList.add('launching');
        overlay.classList.add('fading');
        if (window.triggerStarExplosion) {
          window.triggerStarExplosion();
        }
        await new Promise(resolve => setTimeout(resolve, 1500));
      }

      try {
        const pack = getSelectedModpack();
        const logVersion = getEffectiveGameVersion();
        startNewLogInstance(logVersion, pack?.loader || selectedLoader);
        const result = await ipcRenderer.invoke('launchGame', selectedModpackId);
        if (result.success) {
          addLog('=== Launch successful! Game should be running ===');
          gameRunning = true;
          if (!keepOpen) {
            await new Promise(r => setTimeout(r, 500));
          }
          finishLaunchUI({ hideLayout: !keepOpen });
        } else {
          addLog('=== Launch failed: ' + (result.error || 'Failed to launch the game') + ' ===');
          markActiveLaunchExited();
          finishLaunchUI({ hideLayout: !keepOpen });
          showModal('Launch Failed', result.error || 'Failed to launch the game', true);
        }
      } catch (err) {
        addLog('=== Launch failed: ' + err.message + ' ===');
        markActiveLaunchExited();
        finishLaunchUI({ hideLayout: !keepOpen });
        showModal('Error', 'Failed to launch: ' + err.message, true);
      }
    }

    function formatLogInstanceTime(date) {
      return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }

    function getLogInstanceById(id) {
      return logInstances.find(i => i.id === id) || null;
    }

    function getActiveLogContent() {
      const instance = getLogInstanceById(activeLogInstanceId);
      return instance ? instance.contentEl : null;
    }

    function getLaunchLogContent() {
      const instance = getLogInstanceById(activeLaunchInstanceId);
      return instance ? instance.contentEl : null;
    }

    function closeLogInstanceMenu() {
      const wrap = document.getElementById('logInstanceWrap');
      const trigger = document.getElementById('logInstanceTrigger');
      if (!wrap || !trigger) return;
      wrap.classList.remove('open');
      trigger.setAttribute('aria-expanded', 'false');
    }

    function updateLogInstanceSwitcher() {
      const trigger = document.getElementById('logInstanceTrigger');
      const triggerLabel = document.getElementById('logInstanceTriggerLabel');
      const list = document.getElementById('logInstanceList');
      if (!trigger || !triggerLabel || !list) return;

      if (logInstances.length === 0) {
        trigger.disabled = true;
        triggerLabel.textContent = 'No sessions';
        list.innerHTML = '';
        return;
      }

      trigger.disabled = false;
      const active = getLogInstanceById(activeLogInstanceId) || logInstances[logInstances.length - 1];
      if (active) {
        triggerLabel.textContent = `#${active.id} · ${formatLogInstanceTime(active.startedAt)}`;
      }

      list.innerHTML = [...logInstances].reverse().map(instance => {
        const isActive = instance.id === activeLogInstanceId;
        const loaderLabel = instance.loader === 'fabric' ? 'Fabric' : 'Vanilla';
        return `<button type="button" class="log-instance-item${isActive ? ' active' : ''}" data-instance-id="${instance.id}" role="option" aria-selected="${isActive ? 'true' : 'false'}">
          <span class="log-instance-item-status ${instance.status}"></span>
          <span class="log-instance-item-info">
            <span class="log-instance-item-title">Launch #${instance.id}</span>
            <span class="log-instance-item-meta">${formatLogInstanceTime(instance.startedAt)} · ${instance.version} · ${loaderLabel}</span>
          </span>
          <span class="log-instance-item-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
        </button>`;
      }).join('');

      list.querySelectorAll('.log-instance-item[data-instance-id]').forEach(item => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          switchLogInstance(Number(item.dataset.instanceId));
          closeLogInstanceMenu();
        });
      });
    }

    function switchLogInstance(id) {
      if (!getLogInstanceById(id)) return;
      activeLogInstanceId = id;
      document.querySelectorAll('.log-instance-content').forEach(el => {
        el.classList.toggle('active', Number(el.dataset.instanceId) === id);
      });
      updateLogInstanceSwitcher();
      setLogFilter(activeLogFilter);
      updateLogEmptyState();
      updateLogCount();
    }

    function startNewLogInstance(version, loader) {
      logInstances.filter(i => i.status === 'running').forEach(i => { i.status = 'exited'; });

      logInstanceCounter += 1;
      const id = logInstanceCounter;
      const startedAt = new Date();
      const container = document.getElementById('logInstancesContainer');
      const contentEl = document.createElement('div');
      contentEl.className = 'log-instance-content';
      contentEl.dataset.instanceId = id;
      container.appendChild(contentEl);

      const instance = {
        id,
        startedAt,
        version,
        loader,
        status: 'running',
        contentEl
      };
      logInstances.push(instance);
      activeLaunchInstanceId = id;
      switchLogInstance(id);
    }

    function markLaunchInstanceStatus(message) {
      const instance = getLogInstanceById(activeLaunchInstanceId);
      if (!instance || instance.status !== 'running') return;
      if (message.includes('Game exited') || message.includes('Game process error')) {
        instance.status = 'exited';
        updateLogInstanceSwitcher();
      }
    }

    function markActiveLaunchExited() {
      const instance = getLogInstanceById(activeLaunchInstanceId);
      if (instance && instance.status === 'running') {
        instance.status = 'exited';
        updateLogInstanceSwitcher();
      }
    }

    function initLogInstanceSwitcher() {
      const wrap = document.getElementById('logInstanceWrap');
      const trigger = document.getElementById('logInstanceTrigger');
      if (!wrap || !trigger) return;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        if (trigger.disabled) return;
        closeLoaderMenu();
        closeLauncherActionMenu();
        closeModpackSortMenu();
        const isOpen = wrap.classList.toggle('open');
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target)) closeLogInstanceMenu();
      });
    }

    function getLogLevel(message) {
      const upper = message.toUpperCase();
      if (upper.includes('ERROR') || upper.includes('FAILED') || upper.includes('EXCEPTION')) return 'error';
      if (upper.includes('WARN')) return 'warn';
      return 'info';
    }

    function createLogLine(message, source) {
      const isGame = source === 'game';
      const level = getLogLevel(message);
      const line = document.createElement('div');
      line.className = 'log-line' + (isGame ? ' game' : '') + (level === 'error' ? ' error' : level === 'warn' ? ' warn' : '');
      line.dataset.source = source;
      if (isGame && level === 'info') line.classList.add('no-badge');

      const time = document.createElement('span');
      time.className = 'log-time';
      time.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

      line.appendChild(time);

      if (!isGame || level !== 'info') {
        const badge = document.createElement('span');
        badge.className = 'log-badge ' + level;
        badge.textContent = level === 'error' ? 'Error' : level === 'warn' ? 'Warn' : 'Info';
        line.appendChild(badge);
      }

      const msg = document.createElement('span');
      msg.className = 'log-message';
      msg.textContent = message;

      line.appendChild(msg);
      return line;
    }

    function updateLogEmptyState() {
      const emptyState = document.getElementById('logEmptyState');
      const logContent = getActiveLogContent();
      if (!emptyState) return;
      const noSessions = logInstances.length === 0;
      const empty = !logContent || logContent.children.length === 0;
      emptyState.style.display = (noSessions || empty) ? 'flex' : 'none';
    }

    function updateLogCount() {
      const logContent = getActiveLogContent();
      const countEl = document.getElementById('logLineCount');
      if (!countEl) return;
      if (!logContent) {
        countEl.textContent = '0 entries';
        return;
      }
      const visible = logContent.querySelectorAll('.log-line:not(.hidden)').length;
      const total = logContent.children.length;
      countEl.textContent = activeLogFilter === 'all'
        ? `${total} ${total === 1 ? 'entry' : 'entries'}`
        : `${visible} of ${total} shown`;
    }

    function setLogFilter(filter) {
      activeLogFilter = filter;
      document.querySelectorAll('.log-filter').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.filter === filter);
      });
      const logContent = getActiveLogContent();
      if (!logContent) return;
      logContent.querySelectorAll('.log-line').forEach(line => {
        const source = line.dataset.source || 'launcher';
        const show = filter === 'all' || source === filter;
        line.classList.toggle('hidden', !show);
      });
      updateLogCount();
    }

    function appendLogLine(line, instanceId) {
      const targetId = instanceId ?? activeLaunchInstanceId;
      const logContent = getLogInstanceById(targetId)?.contentEl || getLaunchLogContent();
      const viewport = document.getElementById('logViewport');
      if (!logContent) return;

      logContent.appendChild(line);
      const source = line.dataset.source || 'launcher';
      if (activeLogInstanceId === targetId && activeLogFilter !== 'all' && source !== activeLogFilter) {
        line.classList.add('hidden');
      }

      if (activeLogInstanceId === targetId) {
        updateLogEmptyState();
        updateLogCount();
      }

      const autoScroll = document.getElementById('logAutoScroll');
      if (activeLogInstanceId === targetId && viewport && autoScroll && autoScroll.checked) {
        viewport.scrollTop = viewport.scrollHeight;
      }
    }

    function addLog(message) {
      appendLogLine(createLogLine(message, 'launcher'));
    }

    function addGameLog(message) {
      markLaunchInstanceStatus(message);
      appendLogLine(createLogLine(message, 'game'));
    }

    function copyLogs() {
      const logContent = getActiveLogContent();
      if (!logContent) return;
      const lines = Array.from(logContent.querySelectorAll('.log-line:not(.hidden)'));
      const text = lines.map(el => {
        const time = el.querySelector('.log-time')?.textContent || '';
        const badge = el.querySelector('.log-badge')?.textContent || '';
        const msg = el.querySelector('.log-message')?.textContent || '';
        return `${time} [${badge}] ${msg}`;
      }).join('\n');
      navigator.clipboard.writeText(text).then(() => {
        showToast('Copied', 'Logs copied to clipboard');
      }).catch(() => {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
        showToast('Copied', 'Logs copied to clipboard');
      });
    }

    function clearLogs() {
      const logContent = getActiveLogContent();
      if (logContent) logContent.innerHTML = '';
      updateLogEmptyState();
      updateLogCount();
    }

    ipcRenderer.on('launchProgress', (event, data) => {
      if (data.task) {
        addLog('Progress: ' + data.task + ' (' + Math.round((data.progress || 0) * 100) + '%)');
      }
    });

    ipcRenderer.on('launchLog', (event, message) => {
      addLog(message);
    });

    ipcRenderer.on('gameLog', (event, message) => {
      addGameLog(message);
    });

    ipcRenderer.on('gameStarted', () => {
      gameRunning = true;
      updatePlayButton();
    });

    ipcRenderer.on('gameExit', () => {
      gameRunning = false;
      markActiveLaunchExited();
      updatePlayButton();
      loadModpacks();
    });

    ipcRenderer.on('playTimeUpdated', (event, data) => {
      applyPlayTimeUpdates(data?.updates);
    });

    /* ── WINDOW CONTROLS ── */
    function minimize() { try { window.require('electron').ipcRenderer.send('minimize'); } catch (_) { } }
    function closeLauncher() { try { window.require('electron').ipcRenderer.send('close'); } catch (_) { } }

    /* ── CUSTOM MODAL ── */
    function showModal(title, message, isError = false, isConfirm = false, options = {}) {
      return new Promise((resolve) => {
        const confirmLabel = options.confirmLabel || 'Remove';
        const confirmClass = options.confirmClass || 'confirm';
        const cancelLabel = options.cancelLabel || 'Cancel';
        const modal = document.createElement('div');
        modal.className = 'custom-modal-overlay';
        modal.innerHTML = `
          <div class="custom-modal">
            <div class="custom-modal-title" style="color: ${isError ? '#ff4444' : 'var(--accent)'}">${title}</div>
            <div class="custom-modal-message">${message}</div>
            <div class="custom-modal-buttons">
              ${isConfirm 
                ? `<button class="custom-modal-btn cancel" id="modalCancel">${cancelLabel}</button>
                   <button class="custom-modal-btn ${confirmClass}" id="modalConfirm">${confirmLabel}</button>`
                : `<button class="custom-modal-btn" id="modalOk">OK</button>`
              }
            </div>
          </div>
        `;
        document.body.appendChild(modal);
        
        if (isConfirm) {
          document.getElementById('modalCancel').onclick = () => { modal.remove(); resolve(false); };
          document.getElementById('modalConfirm').onclick = () => { modal.remove(); resolve(true); };
        } else {
          document.getElementById('modalOk').onclick = () => { modal.remove(); resolve(); };
        }
      });
    }

    async function checkLauncherUpdates(manual = false) {
      const ipc = window.ipcRenderer;
      if (!ipc) {
        if (manual) showModal('Update Check Failed', 'Cannot access Electron.', true);
        return;
      }

      const btn = document.getElementById('checkUpdatesBtn');
      const status = document.getElementById('launcherVersionStatus');
      if (btn && manual) {
        btn.disabled = true;
        btn.style.opacity = '0.7';
      }

      try {
        const result = await ipc.invoke('launcher:checkForUpdate');
        const current = result.current || '';
        if (status && current) status.textContent = `v${current}`;

        if (!result.success) {
          if (manual) showModal('Update Check Failed', escapeHtml(result.error || 'Could not reach GitHub.'), true);
          return;
        }

        if (!result.updateAvailable) {
          if (status) status.textContent = `v${current} · up to date`;
          if (manual) showToast('Up to date', `Cosmic Launcher ${current} is the latest version.`);
          return;
        }

        if (status) status.textContent = `v${current} · ${result.latest} available`;
        if (!manual && result.dismissed === result.latest) return;

        const download = await showModal(
          'Update Available',
          `Cosmic Launcher ${escapeHtml(result.latest)} is available. You have ${escapeHtml(current)}.`,
          false,
          true,
          { confirmLabel: 'Download', confirmClass: 'primary', cancelLabel: 'Later' }
        );

        if (download) {
          const url = result.downloadUrl || result.htmlUrl;
          if (url) {
            try { require('electron').shell.openExternal(url); }
            catch (_) { window.open(url, '_blank', 'noopener,noreferrer'); }
          }
        } else if (!manual && result.latest) {
          ipc.invoke('launcher:dismissUpdate', result.latest);
        }
      } catch (err) {
        if (manual) showModal('Update Check Failed', escapeHtml(err.message || 'Could not check for updates.'), true);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.style.opacity = '';
        }
      }
    }

    runStartup();
  </script>
</body>

</html>