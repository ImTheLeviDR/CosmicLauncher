    .modpack-form .loader-wrap.open .loader-trigger {
      border-radius: 8px 8px 0 0;
      border-color: var(--accent);
    }
    .modpack-form .loader-menu {
      width: 100%;
      left: 0;
      right: 0;
      border-radius: 0 0 8px 8px;
      overflow: hidden;
      max-height: 220px;
    }
    .modpack-form .loader-list {
      max-height: 220px;
      overflow-y: auto;
    }
    .modpack-form .loader-list::-webkit-scrollbar {
      width: 6px;
    }
    .modpack-form .loader-list::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.15);
      border-radius: 4px;
    }
    .modpack-form-field.open-above {
      position: relative;
      z-index: 6;
    }
    .modpack-form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 18px;
      position: relative;
      z-index: 0;
    }
    .modpack-form.import-form {
      width: min(560px, 100%);
      max-height: min(82vh, 740px);
      display: flex;
      flex-direction: column;
    }
    .import-instance-search {
      margin-top: 4px;
    }
    .import-instance-list {
      overflow-y: auto;
      max-height: 420px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 12px;
      padding-right: 2px;
    }
    .import-instance-list::-webkit-scrollbar {
      width: 6px;
    }
    .import-instance-list::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.15);
      border-radius: 4px;
    }
    .import-instance-empty {
      text-align: center;
      padding: 28px 12px;
      color: var(--muted);
      font-family: 'Syne', sans-serif;
      font-size: 0.85rem;
    }
    .import-instance-warning {
      font-family: 'Syne', sans-serif;
      font-size: 0.78rem;
      color: #fbbf24;
      margin-top: 4px;
    }

    /* Empty states */
    .mods-empty {
      grid-column: 1 / -1;
      text-align: center;
      padding: 28px 16px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--muted);
      font-family: 'Syne', sans-serif;
      font-size: 0.84rem;
      font-weight: 400;
      line-height: 1.5;
    }

    /* Logs — legacy selectors kept for compatibility */
    .settings-log-content { display: contents; }

    .particles-canvas {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 5;
    }

    .launch-overlay {
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at center, color-mix(in srgb, var(--accent) 18%, var(--bg)) 0%, var(--bg) 100%);
      z-index: 999;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.8s ease, visibility 0.8s ease;
    }

    .launch-overlay {
      position: fixed;
      inset: 0;
      background: var(--bg);
      z-index: 999;
      opacity: 0;
      visibility: hidden;
    }

    .launch-overlay.fading {
      opacity: 1;
      visibility: visible;
      animation: fadeIntoGame 1.5s ease-in-out forwards;
    }

    @keyframes fadeIntoGame {
      0% {
        opacity: 0;
      }
      20% {
        opacity: 0.3;
      }
      50% {
        opacity: 0.7;
        background: #1a120a;
      }
      80% {
        opacity: 0.9;
        background: #0d0906;
      }
      100% {
        opacity: 1;
        background: var(--bg);
      }
    }

    .layout.launching {
      animation: layoutFade 1.3s ease-in-out forwards;
    }

    @keyframes layoutFade {
      0% {
        transform: scale(1);
        opacity: 1;
        filter: blur(0px) brightness(1);
      }
      40% {
        transform: scale(1.02);
        opacity: 0.6;
        filter: blur(1px) brightness(1.2);
      }
      70% {
        transform: scale(1.04);
        opacity: 0.3;
        filter: blur(4px) brightness(1.5);
      }
      100% {
        transform: scale(1.05);
        opacity: 0;
        filter: blur(8px) brightness(2);
      }
    }

    /* ── Onboarding ── */
    .onboard-overlay {
      position: fixed;
      top: 52px;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 95;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 28px 24px 24px;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.55s ease, visibility 0.55s ease;
    }

    body.needs-onboarding:not(.booting) .onboard-overlay:not(.leaving) {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .onboard-overlay.leaving {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .onboard-orbs {
      position: absolute;
      inset: -20%;
      pointer-events: none;
      z-index: 0;
    }

    .onboard-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.55;
      will-change: transform;
    }

    .onboard-orb.orb-a {
      width: 42vmax;
      height: 42vmax;
      left: -8%;
      top: -12%;
      background: color-mix(in srgb, var(--accent) 55%, transparent);
      animation: onboardOrbA 18s ease-in-out infinite;
    }

    .onboard-orb.orb-b {
      width: 36vmax;
      height: 36vmax;
      right: -10%;
      bottom: -16%;
      background: color-mix(in srgb, var(--accent2) 48%, transparent);
      animation: onboardOrbB 22s ease-in-out infinite;
    }

    .onboard-orb.orb-c {
      width: 24vmax;
      height: 24vmax;
      left: 42%;
      top: 38%;
      background: color-mix(in srgb, var(--accent) 22%, #7c5cff 40%);
      animation: onboardOrbC 16s ease-in-out infinite;
    }

    @keyframes onboardOrbA {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(8%, 10%) scale(1.12); }
    }

    @keyframes onboardOrbB {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-10%, -8%) scale(1.18); }
    }

    @keyframes onboardOrbC {
      0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.4; }
      50% { transform: translate(-6%, 8%) scale(1.25); opacity: 0.7; }
    }

    .onboard-shell {
      position: relative;
      z-index: 1;
      width: min(760px, 100%);
      max-height: 100%;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .onboard-pages {
      flex: 1;
      min-height: 0;
      display: flex;
      align-items: stretch;
    }

    .onboard-page {
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      width: 100%;
      min-height: 0;
    }

    .onboard-page.active {
      display: flex;
      animation: onboardIn 0.62s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .onboard-page.active.from-back {
      animation-name: onboardInBack;
    }

    @keyframes onboardIn {
      from { opacity: 0; transform: translateY(28px) scale(0.985); filter: blur(10px); }
      to { opacity: 1; transform: none; filter: none; }
    }

    @keyframes onboardInBack {
      from { opacity: 0; transform: translateY(-18px) scale(0.99); filter: blur(8px); }
      to { opacity: 1; transform: none; filter: none; }
    }

    .onboard-kicker {
      font-family: 'Space Mono', monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent2);
      margin-bottom: 10px;
      animation: onboardFadeUp 0.7s 0.05s both;
    }

    .onboard-title {
      font-family: 'Syne', sans-serif;
      font-size: clamp(2rem, 4.6vw, 3.35rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.08;
      margin-bottom: 12px;
      background: linear-gradient(115deg, var(--text) 12%, var(--accent2) 52%, var(--accent) 92%);
      background-size: 180% 180%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: onboardFadeUp 0.75s 0.12s both, onboardShine 10s ease-in-out infinite;
    }

    @keyframes onboardShine {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    .onboard-copy {
      font-family: 'Syne', sans-serif;
      font-size: 0.98rem;
      font-weight: 400;
      color: var(--muted);
      line-height: 1.55;
      max-width: 520px;
      margin-bottom: 28px;
      animation: onboardFadeUp 0.75s 0.2s both;
    }

    @keyframes onboardFadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: none; }
    }

    .onboard-logo-wrap {
      position: relative;
      width: 108px;
      height: 108px;
      margin: 8px 0 28px;
    }

    .onboard-logo {
      width: 108px;
      height: 108px;
      border-radius: 28px;
      object-fit: cover;
      box-shadow:
        0 0 0 1px color-mix(in srgb, var(--accent) 22%, transparent),
        0 18px 50px var(--glow);
    }

    .onboard-theme-grid {
      width: 100%;
      animation: onboardFadeUp 0.7s 0.18s both;
    }

    .onboard-theme-grid.theme-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .onboard-account-card {
      display: flex;
      align-items: center;
      gap: 16px;
      width: min(420px, 100%);
      padding: 16px 18px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: color-mix(in srgb, var(--panel) 80%, transparent);
      backdrop-filter: blur(18px);
      text-align: left;
      margin-bottom: 18px;
      animation: onboardFadeUp 0.7s 0.16s both;
    }

    .onboard-account-card img {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      object-fit: cover;
      box-shadow: 0 0 24px var(--player-glow);
    }

    .onboard-account-name {
      font-family: 'Syne', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text);
    }

    .onboard-account-meta {
      font-family: 'Syne', sans-serif;
      font-size: 0.8rem;
      color: var(--muted);
      margin-top: 2px;
    }

    .onboard-ms-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 44px;
      padding: 0 20px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.16);
      background: rgba(255,255,255,0.08);
      color: var(--text);
      font-family: 'Syne', sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      animation: onboardFadeUp 0.7s 0.22s both;
      transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

    .onboard-ms-btn:hover {
      background: rgba(255,255,255,0.14);
      border-color: rgba(255,255,255,0.28);
      transform: translateY(-1px);
    }

    .onboard-ms-btn svg {
      width: 18px;
      height: 18px;
    }

    .onboard-import {
      width: 100%;
      display: flex;
      flex-direction: column;
      min-height: 0;
      flex: 1;
      animation: onboardFadeUp 0.7s 0.16s both;
    }

    .onboard-import-search {
      width: 100%;
      min-height: 42px;
      padding: 0 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: rgba(0,0,0,0.32);
      color: var(--text);
      font-family: 'Syne', sans-serif;
      font-size: 0.9rem;
      outline: none;
      margin-bottom: 12px;
    }

    .onboard-import-search:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--glow);
    }

    .onboard-import-list {
      overflow-y: auto;
      max-height: min(38vh, 340px);
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-right: 4px;
      text-align: left;
    }

    .onboard-import-list::-webkit-scrollbar { width: 6px; }
    .onboard-import-list::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.16);
      border-radius: 4px;
    }

    .onboard-instance {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 13px 14px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.035);
      transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
    }

    .onboard-instance:hover {
      background: rgba(255,255,255,0.06);
      border-color: rgba(255,255,255,0.14);
      transform: translateY(-1px);
    }

    .onboard-instance.imported {
      border-color: color-mix(in srgb, var(--accent) 50%, transparent);
      background: color-mix(in srgb, var(--accent) 10%, rgba(255,255,255,0.03));
    }

    .onboard-instance-name {
      font-family: 'Syne', sans-serif;
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--text);
    }

    .onboard-instance-meta {
      font-family: 'Syne', sans-serif;
      font-size: 0.76rem;
      color: var(--muted);
      margin-top: 2px;
    }

    .onboard-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding-top: 4px;
    }

    .onboard-dots {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .onboard-dot {
      width: 8px;
      height: 8px;
      border-radius: 99px;
      background: rgba(255,255,255,0.16);
      transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease;
    }

    .onboard-dot.active {
      width: 26px;
      background: var(--accent);
      box-shadow: 0 0 16px var(--glow);
    }

    .onboard-dot.done {
      background: color-mix(in srgb, var(--accent2) 70%, white 10%);
    }

    .onboard-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .onboard-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 18px;
      border-radius: 10px;
      font-family: 'Syne', sans-serif;
      font-size: 0.86rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    }

    .onboard-btn.ghost {
      background: transparent;
      border: 1px solid transparent;
      color: var(--muted);
    }

    .onboard-btn.ghost:hover {
      color: var(--text);
      background: rgba(255,255,255,0.05);
    }

    .onboard-btn.primary {
      background: var(--accent);
      border: 1px solid color-mix(in srgb, var(--accent) 70%, white 18%);
      color: #fff;
      min-width: 128px;
      box-shadow: 0 10px 28px var(--glow);
    }

    .onboard-btn.primary:hover {
      background: var(--accent-hover);
      transform: translateY(-1px);
    }

    .onboard-btn.primary:active {
      transform: translateY(0);
    }

    .onboard-btn:disabled {
      opacity: 0.55;
      cursor: default;
      transform: none;
    }

    .onboard-btn[hidden] {
      display: none !important;
    }

    .onboard-summary {
      width: min(440px, 100%);
      border-radius: 18px;
      border: 1px solid var(--border);
      background: color-mix(in srgb, var(--panel) 80%, transparent);
      backdrop-filter: blur(18px);
      overflow: hidden;
      text-align: left;
      animation: onboardFadeUp 0.7s 0.18s both;
    }

    .onboard-summary-hero {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 18px;
      background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%);
      border-bottom: 1px solid var(--border);
    }

    .onboard-summary-avatar {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      object-fit: cover;
      flex-shrink: 0;
      box-shadow: 0 0 22px var(--player-glow);
    }

    .onboard-summary-name {
      font-family: 'Syne', sans-serif;
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text);
      line-height: 1.2;
    }

    .onboard-summary-sub {
      font-family: 'Syne', sans-serif;
      font-size: 0.8rem;
      color: var(--muted);
      margin-top: 3px;
    }

    .onboard-summary-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 13px 18px;
    }

    .onboard-summary-row + .onboard-summary-row {
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .onboard-summary-row[hidden] {
      display: none !important;
    }

    .onboard-summary-key {
      font-family: 'Space Mono', monospace;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .onboard-summary-val {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'Syne', sans-serif;
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text);
      text-align: right;
    }

    .onboard-summary-swatch {
      width: 16px;
      height: 16px;
      border-radius: 5px;
      flex-shrink: 0;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    }

    @media (max-width: 720px) {
      .onboard-theme-grid.theme-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .onboard-footer {
        flex-direction: column;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .onboard-orb,
      .onboard-title,
      .onboard-page.active {
        animation: none;
      }
    }
  </style>
</head>

<body class="booting<%= onboardingCompleted ? '' : ' needs-onboarding' %>">

  <canvas id="nebula"></canvas>
  <div class="grain"></div>
  <div class="launch-overlay" id="launchOverlay"></div>
  <audio id="launchSound" src="<%= assetRoot %>sounds/launch.mp3" preload="auto"></audio>

  <div class="titlebar">
    <div class="tb-brand">
      <img src="<%= assetRoot %>app/assets/logo.png" alt="" class="tb-logo">
      <span class="tb-name">Cosmic Launcher</span>
    </div>
    <div class="tb-drag-spacer" aria-hidden="true"></div>
    <div class="tb-actions">
      <div class="tb-control-group">
        <button type="button" class="tb-seg-btn tb-win-btn" onclick="minimize()" title="Minimize" aria-label="Minimize">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="8" x2="13" y2="8"></line>
          </svg>
        </button>
        <button type="button" class="tb-seg-btn tb-win-btn close" onclick="closeLauncher()" title="Close" aria-label="Close">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M4.5 4.5l7 7M11.5 4.5l-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <% const onboardAccount = (selectedUuid && accounts[selectedUuid]) ? accounts[selectedUuid] : null; %>
  <div class="onboard-overlay" id="onboardOverlay" role="dialog" aria-modal="true" aria-labelledby="onboardTitle">
    <div class="onboard-orbs" aria-hidden="true">
      <span class="onboard-orb orb-a"></span>
      <span class="onboard-orb orb-b"></span>
      <span class="onboard-orb orb-c"></span>
    </div>
    <div class="onboard-shell">
      <div class="onboard-pages" id="onboardPages">
        <section class="onboard-page active" data-page="0">
          <div class="onboard-logo-wrap" aria-hidden="true">
            <img class="onboard-logo" src="<%= assetRoot %>app/assets/logo.png" alt="">
          </div>
          <p class="onboard-kicker">Cosmic Launcher</p>
          <h1 class="onboard-title" id="onboardTitle">Welcome to the cosmos</h1>
          <p class="onboard-copy">A beautiful, lightweight Minecraft launcher. A few quick steps and you are ready to play.</p>
        </section>

        <section class="onboard-page" data-page="1">
          <p class="onboard-kicker">Appearance</p>
          <h1 class="onboard-title">Pick your colors</h1>
          <p class="onboard-copy">Themes update live. You can change this anytime in Settings.</p>
          <div class="theme-grid onboard-theme-grid" id="onboardThemeGrid"></div>
        </section>

        <section class="onboard-page" data-page="2">
          <p class="onboard-kicker">Account</p>
          <h1 class="onboard-title"><%= onboardAccount ? 'You are signed in' : 'Sign in to play' %></h1>
          <p class="onboard-copy"><%= onboardAccount ? 'This Microsoft account will be used to launch Minecraft. You can add more later.' : 'Cosmic uses your Microsoft account to launch Minecraft. You can add it later from the home screen.' %></p>
          <div class="onboard-account-card" id="onboardAccountCard" <%= onboardAccount ? '' : 'hidden' %>>
            <img src="" alt="" id="onboardAccountImg" data-uuid="<%= onboardAccount ? selectedUuid : '' %>" data-name="<%= onboardAccount ? onboardAccount.displayName : 'Steve' %>">
            <div>
              <div class="onboard-account-name" id="onboardAccountName"><%= onboardAccount ? onboardAccount.displayName : 'Steve' %></div>
              <div class="onboard-account-meta" id="onboardAccountMeta">Microsoft account</div>
            </div>
          </div>
          <button type="button" class="onboard-ms-btn" id="onboardLoginBtn">
            <svg viewBox="0 0 21 21" aria-hidden="true">
              <rect x="1" y="1" width="9" height="9" fill="#f25022"></rect>
              <rect x="11" y="1" width="9" height="9" fill="#7fba00"></rect>
              <rect x="1" y="11" width="9" height="9" fill="#00a4ef"></rect>
              <rect x="11" y="11" width="9" height="9" fill="#ffb900"></rect>
            </svg>
            <span id="onboardLoginLabel"><%= onboardAccount ? 'Use a different account' : 'Sign in with Microsoft' %></span>
          </button>
        </section>

        <section class="onboard-page" data-page="3">
          <p class="onboard-kicker">Modrinth</p>
          <h1 class="onboard-title">Bring your instances</h1>
          <p class="onboard-copy">Import any instance from the Modrinth App — mods, worlds, resource packs, and settings. Continue if you want a fresh start.</p>
          <div class="onboard-import">
            <input id="onboardImportSearch" class="onboard-import-search" type="search" placeholder="Search Modrinth instances..." autocomplete="off" spellcheck="false">
            <div class="onboard-import-list" id="onboardImportList">
              <div class="import-instance-empty">Looking for Modrinth App...</div>
            </div>
          </div>
        </section>

        <section class="onboard-page" data-page="4">
          <p class="onboard-kicker">All set</p>
          <h1 class="onboard-title">Ready to launch</h1>
          <p class="onboard-copy">Here is your setup. Everything stays editable in Settings.</p>
          <div class="onboard-summary">
            <div class="onboard-summary-hero">
              <img src="" alt="" class="onboard-summary-avatar" id="onboardSummaryAvatar">
              <div>
                <div class="onboard-summary-name" id="onboardSummaryName">Steve</div>
                <div class="onboard-summary-sub" id="onboardSummarySub">No account yet</div>
              </div>
            </div>
            <div class="onboard-summary-row">
              <span class="onboard-summary-key">Theme</span>
              <span class="onboard-summary-val">
                <span class="onboard-summary-swatch" id="onboardSummarySwatch" aria-hidden="true"></span>
                <span id="onboardSummaryTheme">Cosmic</span>
              </span>
            </div>
            <div class="onboard-summary-row">
              <span class="onboard-summary-key">Modpacks</span>
              <span class="onboard-summary-val" id="onboardSummaryPacks">1 ready to play</span>
            </div>
            <div class="onboard-summary-row" id="onboardSummaryImportRow" hidden>
              <span class="onboard-summary-key">Imported</span>
              <span class="onboard-summary-val" id="onboardSummaryImports">1 from Modrinth</span>
            </div>
          </div>
        </section>
      </div>

      <div class="onboard-footer">
        <div class="onboard-dots" id="onboardDots" aria-hidden="true"></div>
        <div class="onboard-actions">
          <button type="button" class="onboard-btn ghost" id="onboardSkip" hidden>Skip</button>
          <button type="button" class="onboard-btn ghost" id="onboardBack" hidden>Back</button>
          <button type="button" class="onboard-btn primary" id="onboardNext">Continue</button>
        </div>
      </div>
    </div>
  </div>

  <canvas class="particles-canvas" id="particles"></canvas>

  <div class="panel-actions">
    <div class="tb-control-group panel-control-group">
      <div class="profile-wrap" id="profileWrap">
        <button type="button" class="tb-seg-btn header-btn-profile" id="profileTrigger" aria-expanded="false" aria-haspopup="true" title="Switch account">
          <img src="" alt="" class="profile-head-img" id="activeProfileImg" data-uuid="<%= selectedUuid || '' %>" data-name="<%= (selectedUuid && accounts[selectedUuid]) ? accounts[selectedUuid].displayName : 'Steve' %>">
          <span class="profile-name" id="activeProfileName" data-uuid="<%= selectedUuid || '' %>"><%= (selectedUuid && accounts[selectedUuid]) ? accounts[selectedUuid].displayName : 'Account' %></span>
          <span class="profile-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
        </button>

        <div class="profile-dropdown" id="profileDropdown">
          <div class="profile-list" id="profileList">
            <% const accountKeys = Object.keys(accounts); %>
            <% if (accountKeys.length === 0) { %>
              <div class="profile-item"><span class="profile-info">No accounts</span></div>
            <% } else { %>
              <% accountKeys.forEach(function(uuid) { %>
                <% const acc = accounts[uuid]; %>
                <div class="profile-item<%= uuid === selectedUuid ? ' active' : '' %>" data-name="<%= acc.displayName %>" data-uuid="<%= uuid %>">
                  <img src="" alt="Head" class="profile-head-img" data-uuid="<%= uuid %>" data-name="<%= acc.displayName %>">
                  <div class="profile-info">
                    <span class="profile-item-name"><%= acc.displayName %></span>
                    <span class="profile-item-type"><%= acc.type === 'microsoft' ? 'Microsoft' : 'Mojang' %></span>
                  </div>
                  <div class="profile-actions">
                    <span class="profile-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                    <span class="profile-delete" title="Remove account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"></path><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path><path d="M7 7l1 12a1 1 0 0 0 1 .9h6a1 1 0 0 0 1-.9L17 7"></path><path d="M10 11v5M14 11v5"></path></svg></span>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>

          <div class="profile-divider"></div>

          <div class="add-account-btn" id="addAccountBtn">
            <div class="add-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </div>
            <span>Add Microsoft Account</span>
          </div>
        </div>
      </div>

      <button type="button" class="tb-seg-btn tb-settings-btn" onclick="openSettings()" title="Settings" aria-label="Settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="layout" id="layout">

    <div class="right-panel">
      <div class="game-title">Cosmic<br>Launcher</div>
      <div class="game-subtitle">A beautiful lightweight launcher</div>

      <div class="divider"></div>

      <div class="play-wrap">
        <button class="play-btn" id="playBtn">
          <div class="play-btn-main" id="playBtnLabel"><span id="playBtnIcon">&#x25B6;</span>&nbsp;<span class="play-status-text" id="playBtnStatus">Launch</span></div>
          <div class="play-btn-version" id="playBtnDots">
            <span class="play-btn-ver-icon">&#x25BE;</span>
          </div>
        </button>
        <div class="version-label" id="versionLabel">Modpack: <span id="versionLabelText"><%= selectedModpack ? selectedModpack.name : 'Latest' %></span></div>
        <div class="playtime-label" id="playtimeLabel" data-playtime-id="<%= selectedModpack ? selectedModpack.id : 'default' %>">Not played yet</div>
      </div>

    </div>

    <div class="player-model-panel" id="playerModelPanel" aria-hidden="true">
      <canvas id="playerSkinCanvas"></canvas>
    </div>

  </div>

  <!-- Modpack Popup -->
  <div class="version-popup" id="versionPopup" onclick="handlePopupBackdropClick(event)">
    <div class="version-popup-panel" onclick="event.stopPropagation()">
      <div class="version-popup-header">
        <div class="version-popup-header-text">
          <div class="version-popup-heading">Modpacks</div>
          <div class="version-popup-desc">Choose which modpack to launch. Each has its own Minecraft folder.</div>
        </div>
        <button type="button" class="version-popup-close" onclick="closeVersionPopup()" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="version-popup-search">
        <span class="version-popup-search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line></svg>
        </span>
        <input type="search" id="versionSearchInput" class="version-popup-search-input" placeholder="Search modpacks..." autocomplete="off" spellcheck="false" aria-label="Search modpacks">
      </div>
      <div class="version-popup-list loader-list" id="versionList" role="listbox" aria-label="Modpacks"></div>
      <div class="modpack-popup-footer">
        <button type="button" class="mod-btn install" id="importModpackPopupBtn" onclick="openImportModpackModal()">Import</button>
