    const COLOR_THEMES = [
      { id: 'cosmic', label: 'Cosmic', bg: '#04040d', accent: '#e8622a', accent2: '#f0a842' },
      { id: 'nebula', label: 'Nebula', bg: '#06040f', accent: '#8b5cf6', accent2: '#c4b5fd' },
