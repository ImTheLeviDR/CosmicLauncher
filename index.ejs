    let selectedTheme = '<%= theme %>';
    let resolvedAutoTheme = 'cosmic';
    let autoThemeRequest = 0;

    function hexToRgb(hex) {
      const value = hex.replace('#', '');
      return [
        parseInt(value.slice(0, 2), 16),
        parseInt(value.slice(2, 4), 16),
        parseInt(value.slice(4, 6), 16),
      ];
    }

    function rgbToHsl(r, g, b) {
      r /= 255;
      g /= 255;
      b /= 255;
      const max = Math.max(r, g, b);
      const min = Math.min(r, g, b);
      const l = (max + min) / 2;
      if (max === min) return { h: 0, s: 0, l };

      const d = max - min;
      const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      let h;

      switch (max) {
        case r: h = ((g - b) / d + (g < b ? 6 : 0)) / 6; break;
        case g: h = ((b - r) / d + 2) / 6; break;
        default: h = ((r - g) / d + 4) / 6; break;
      }

      return { h: h * 360, s, l };
    }

    function hueDistance(a, b) {
      const diff = Math.abs(a - b) % 360;
      return diff > 180 ? 360 - diff : diff;
    }

    function colorMatchScore(rgb, hex) {
      const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
      const target = rgbToHsl(...hexToRgb(hex));
      if (hsl.s < 0.08) {
        return hueDistance(hsl.h, target.h) * 0.35 + Math.abs(hsl.l - target.l) * 120;
      }
      return hueDistance(hsl.h, target.h) * 1.4 + Math.abs(hsl.s - target.s) * 90 + Math.abs(hsl.l - target.l) * 45;
    }

    function isNeutralPixel(r, g, b, a) {
      if (a < 128) return true;
      const brightness = (r + g + b) / 3;
      if (brightness < 24 || brightness > 244) return true;
      const spread = Math.max(r, g, b) - Math.min(r, g, b);
      return spread < 18;
    }

    function findClosestTheme(rgb) {
      let bestId = 'cosmic';
      let bestScore = Infinity;

      for (const theme of COLOR_THEMES) {
        const score = Math.min(
          colorMatchScore(rgb, theme.accent),
          colorMatchScore(rgb, theme.accent2),
        );
        if (score < bestScore) {
          bestScore = score;
          bestId = theme.id;
        }
      }

      return bestId;
    }

    function sampleImageData(data, width, height) {
      const buckets = new Map();

      for (let i = 0; i < data.length; i += 4) {
        const r = data[i];
        const g = data[i + 1];
        const b = data[i + 2];
        const a = data[i + 3];
        if (isNeutralPixel(r, g, b, a)) continue;

        const key = `${Math.round(r / 20) * 20},${Math.round(g / 20) * 20},${Math.round(b / 20) * 20}`;
        buckets.set(key, (buckets.get(key) || 0) + 1);
      }

      let bestKey = null;
      let bestCount = 0;
      for (const [key, count] of buckets) {
        if (count > bestCount) {
          bestCount = count;
          bestKey = key;
        }
      }

      if (!bestKey) return null;
      const [r, g, b] = bestKey.split(',').map(Number);
      return { r, g, b };
    }

    function sampleSkinDominantColor(skinUrl) {
      return new Promise((resolve) => {
        const finish = (color) => resolve(color);

        const loadFromUrl = (url, revoke) => {
          const img = new Image();
          img.onload = () => {
            try {
              const canvas = document.createElement('canvas');
              const width = img.naturalWidth || img.width;
              const height = img.naturalHeight || img.height;
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext('2d', { willReadFrequently: true });
              ctx.drawImage(img, 0, 0);
              finish(sampleImageData(ctx.getImageData(0, 0, width, height).data));
            } catch (_) {
              finish(null);
            } finally {
              if (revoke) URL.revokeObjectURL(revoke);
            }
          };
          img.onerror = () => {
            if (revoke) URL.revokeObjectURL(revoke);
            finish(null);
          };
          img.src = url;
        };

        if (typeof require === 'function') {
          try {
            const https = require('https');
            const http = require('http');

            const fetchBuffer = (url, redirects = 0) => new Promise((res, rej) => {
              if (redirects > 5) {
                rej(new Error('Too many redirects'));
                return;
              }
              const client = url.startsWith('https:') ? https : http;
              client.get(url, (response) => {
                if (response.statusCode >= 300 && response.statusCode < 400 && response.headers.location) {
                  fetchBuffer(response.headers.location, redirects + 1).then(res).catch(rej);
                  return;
                }
                if (response.statusCode !== 200) {
                  rej(new Error(`HTTP ${response.statusCode}`));
                  return;
                }
                const chunks = [];
                response.on('data', (chunk) => chunks.push(chunk));
                response.on('end', () => res(Buffer.concat(chunks)));
              }).on('error', rej);
            });

            fetchBuffer(skinUrl).then((buffer) => {
              const blobUrl = URL.createObjectURL(new Blob([buffer], { type: 'image/png' }));
              loadFromUrl(blobUrl, blobUrl);
            }).catch(() => {
              const img = new Image();
              img.crossOrigin = 'anonymous';
              img.onload = () => {
                try {
                  const canvas = document.createElement('canvas');
                  const width = img.naturalWidth || img.width;
                  const height = img.naturalHeight || img.height;
                  canvas.width = width;
                  canvas.height = height;
                  const ctx = canvas.getContext('2d', { willReadFrequently: true });
                  ctx.drawImage(img, 0, 0);
                  finish(sampleImageData(ctx.getImageData(0, 0, width, height).data));
                } catch (_) {
                  finish(null);
                }
              };
              img.onerror = () => finish(null);
              img.src = skinUrl;
            });
            return;
          } catch (_) {}
        }

        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = () => {
          try {
            const canvas = document.createElement('canvas');
            const width = img.naturalWidth || img.width;
            const height = img.naturalHeight || img.height;
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d', { willReadFrequently: true });
            ctx.drawImage(img, 0, 0);
            finish(sampleImageData(ctx.getImageData(0, 0, width, height).data));
          } catch (_) {
            finish(null);
          }
        };
        img.onerror = () => finish(null);
        img.src = skinUrl;
      });
    }

