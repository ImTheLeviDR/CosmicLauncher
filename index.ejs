      'href', 'id', 'loading', 'name', 'r', 'rel', 'rowspan', 'rx', 'ry', 'sizes',
      'src', 'srcset', 'stroke', 'stroke-width', 'style', 'target', 'title',
      'transform', 'viewbox', 'width', 'x', 'x1', 'x2', 'xmlns', 'y', 'y1', 'y2'
    ]);

    function isSafeUrl(value) {
      if (!value) return false;
      const v = String(value).trim();
      return /^(https?:)?\/\//i.test(v) || v.startsWith('data:image/') || v.startsWith('#');
    }

    function sanitizeMarkdownHtml(dirty) {
      const template = document.createElement('template');
      template.innerHTML = dirty;

      const elements = Array.from(template.content.querySelectorAll('*')).reverse();
      for (const el of elements) {
        if (!el.isConnected && el.parentNode == null) continue;
        const tag = el.tagName.toUpperCase();

        if (!MARKDOWN_ALLOWED_TAGS.has(tag)) {
          el.replaceWith(...Array.from(el.childNodes));
          continue;
        }

        for (const attr of Array.from(el.attributes)) {
          const name = attr.name.toLowerCase();
          const value = attr.value || '';
          if (name.startsWith('on') || name === 'srcdoc') {
            el.removeAttribute(attr.name);
            continue;
          }
          if (!MARKDOWN_ALLOWED_ATTRS.has(name)) {
            el.removeAttribute(attr.name);
            continue;
          }
          if ((name === 'href' || name === 'src') && /^\s*javascript:/i.test(value)) {
            el.removeAttribute(attr.name);
            continue;
          }
          if (name === 'style' && /(expression|javascript:)/i.test(value)) {
            el.removeAttribute(attr.name);
          }
        }

        if (tag === 'A') {
          const href = el.getAttribute('href');
          if (href && isSafeUrl(href) && !href.startsWith('#')) {
            const abs = href.startsWith('//') ? ('https:' + href) : href;
            if (/^https?:/i.test(abs)) {
              el.setAttribute('href', abs);
              el.setAttribute('data-external', 'true');
              el.setAttribute('rel', 'noopener noreferrer');
            }
          } else if (href && !href.startsWith('#')) {
            el.removeAttribute('href');
          }
        }

        if (tag === 'IMG') {
          let srcAttr = el.getAttribute('src') || '';
          if (srcAttr.startsWith('//')) srcAttr = 'https:' + srcAttr;
          if (!/^https?:\/\//i.test(srcAttr) && !srcAttr.startsWith('data:image/')) {
            el.remove();
            continue;
          }
          el.setAttribute('src', srcAttr);
          el.setAttribute('loading', 'lazy');
          const srcset = el.getAttribute('srcset');
          if (srcset && /javascript:/i.test(srcset)) el.removeAttribute('srcset');
        }

        if (tag === 'SOURCE') {
          const srcAttr = el.getAttribute('src') || '';
          if (srcAttr.startsWith('//')) el.setAttribute('src', 'https:' + srcAttr);
        }
      }

      template.content.querySelectorAll('comment, script, iframe, object, embed').forEach((n) => n.remove());
      return template.innerHTML;
    }

    function renderMarkdownFallback(src) {
      // Lightweight HTML-aware fallback if marked fails to load
      let text = String(src || '').replace(/\r\n/g, '\n');
      const blocks = [];
      text = text.replace(/```([\s\S]*?)```/g, (_, code) => {
        const i = blocks.length;
        blocks.push(`<pre><code>${escapeHtml(code.replace(/^\n/, '').replace(/\n$/, ''))}</code></pre>`);
        return `\n%%MD_BLOCK_${i}%%\n`;
      });
      text = text.replace(/^(#{1,4})\s+(.+)$/gm, (_, h, title) => `<h${h.length}>${title}</h${h.length}>`);
      text = text.replace(/^\s*[-*+]\s+(.+)$/gm, '<li>$1</li>');
      text = text.replace(/(?:<li>.*<\/li>\n?)+/g, (m) => `<ul>${m}</ul>`);
      text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      text = text.replace(/__([^_]+)__/g, '<strong>$1</strong>');
      text = text.replace(/!\[([^\]]*)\]\((https?:[^)\s]+)\)/g, '<img src="$2" alt="$1" loading="lazy">');
      text = text.replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" data-external="true">$1</a>');
      text = text.replace(/`([^`]+)`/g, '<code>$1</code>');
      text = text.replace(/^(?!<[a-zA-Z/]|%%MD_BLOCK_)(.+)$/gm, '<p>$1</p>');
      text = text.replace(/%%MD_BLOCK_(\d+)%%/g, (_, i) => blocks[Number(i)] || '');
      return sanitizeMarkdownHtml(text);
    }

    function renderMarkdown(src) {
      const text = String(src || '').replace(/\r\n/g, '\n').trim();
      if (!text) return '<p>No description provided.</p>';
      try {
        if (markedParse) {
          const dirty = markedParse(text, { async: false });
          return sanitizeMarkdownHtml(String(dirty));
        }
      } catch (err) {
        console.error('Markdown render failed:', err);
      }
      return renderMarkdownFallback(text);
    }

    function bindMarkdownLinks(root) {
