    }
    .mod-tag.current {
      color: #86efac;
      background: rgba(34, 197, 94, 0.14);
      border-color: rgba(34, 197, 94, 0.3);
    }
    .mod-version-meta {
      font-family: 'Syne', sans-serif;
      font-size: 0.75rem;
      color: var(--muted);
    }
    .modpack-form-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.55);
      z-index: 12000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .modpack-form {
      width: min(440px, 100%);
      background: color-mix(in srgb, var(--bg) 92%, #111);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 22px;
      box-shadow: 0 24px 60px rgba(0,0,0,0.45);
    }
    .modpack-form-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 6px;
    }
    .modpack-form-desc {
      font-family: 'Syne', sans-serif;
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 16px;
    }
    .modpack-form label {
      display: block;
      font-family: 'Syne', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--muted);
      margin-bottom: 6px;
      margin-top: 12px;
    }
    .modpack-form input {
      width: 100%;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: rgba(0,0,0,0.35);
