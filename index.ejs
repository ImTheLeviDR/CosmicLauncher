  <script src="https://cdn.jsdelivr.net/npm/skinview3d/bundles/skinview3d.bundle.js"></script>
  <script>
    /* ── NEBULA CANVAS ── */
    (function () {
      const canvas = document.getElementById('nebula');
      const ctx = canvas.getContext('2d');
      function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
      resize();
      window.addEventListener('resize', resize);

      function readThemeHue(name, fallback) {
        const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
        const parsed = parseFloat(value);
        return Number.isFinite(parsed) ? parsed : fallback;
      }

      function randomWarmHue() {
        const base = readThemeHue('--nebula-warm', 22);
        return base + Math.random() * 18;
      }

      function randomCoolHue() {
        const base = readThemeHue('--nebula-cool', 260);
        return base + Math.random() * 40;
      }

      const blobs = Array.from({ length: 7 }, (_, i) => ({
        x: Math.random() * canvas.width, y: Math.random() * canvas.height,
        r: 200 + Math.random() * 320,
        hue: i < 3 ? randomWarmHue() : randomCoolHue(),
        speed: (Math.random() - 0.5) * 0.15, vy: (Math.random() - 0.5) * 0.08,
        phase: Math.random() * Math.PI * 2, alpha: 0.04 + Math.random() * 0.07,
      }));
      const starfield = [];
      for (let i = 0; i < 400; i++) {
        starfield.push({
          x: (Math.random() - 0.5) * 2000,
          y: (Math.random() - 0.5) * 2000,
          z: Math.random() * 400 + 50,
          a: 0.3 + Math.random() * 0.7,
        });
      }
      let t = 0;
      let closing = false;
      let warpSpeed = 0;
      let openZoom = 0;
      let wasOpening = false;
      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        t += 0.006;
        if (closing) warpSpeed = Math.min(warpSpeed + 2, 80);
        if (openZoom > 0) {
          openZoom -= 0.8;
          wasOpening = true;
        }
        if (openZoom <= 0 && wasOpening) {
          starfield.forEach(s => { s.z = Math.random() * 400 + 50; });
          wasOpening = false;
        }
        if (!closing && openZoom <= 0) starfield.forEach(s => { s.z -= 0.5; if (s.z <= 30) s.z = 450; });
        const cx = canvas.width / 2, cy = canvas.height / 2;
        starfield.forEach(s => {
          if (closing) s.z -= warpSpeed;
          if (openZoom > 0) s.z -= openZoom;
          if (s.z <= 10) s.z = 500;
          const scale = 200 / s.z;
          const px = cx + s.x * scale;
          const py = cy + s.y * scale;
          const size = Math.max(1, (200 - s.z) / 80) * (closing ? 2.5 : 1);
          const alpha = Math.min(1, (450 - s.z) / 200) * s.a * (closing ? 1.5 : 1);
          if (px > -10 && px < canvas.width + 10 && py > -10 && py < canvas.height + 10) {
            ctx.beginPath();
            ctx.arc(px, py, size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255,245,220,${alpha})`;
            ctx.fill();
          }
        });
        if (!closing && openZoom <= 0) {
          blobs.forEach(b => {
            b.x += b.speed; b.y += b.vy;
            if (b.x > canvas.width + b.r) b.x = -b.r;
            if (b.x < -b.r) b.x = canvas.width + b.r;
            if (b.y > canvas.height + b.r) b.y = -b.r;
            if (b.y < -b.r) b.y = canvas.height + b.r;
            const pulse = 1 + 0.05 * Math.sin(t + b.phase);
            const grad = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r * pulse);
            grad.addColorStop(0, `hsla(${b.hue},80%,55%,${b.alpha * 1.5})`);
            grad.addColorStop(0.5, `hsla(${b.hue},70%,40%,${b.alpha * 0.5})`);
            grad.addColorStop(1, `hsla(${b.hue},60%,20%,0)`);
            ctx.beginPath(); ctx.arc(b.x, b.y, b.r * pulse, 0, Math.PI * 2);
            ctx.fillStyle = grad; ctx.fill();
          });
        }
        requestAnimationFrame(draw);
      }
      draw();
      window.triggerStarExplosion = () => { closing = true; };
      window.triggerOpenAnimation = () => { if (openZoom <= 0) openZoom = 30; };
      window.resetStars = () => { closing = false; warpSpeed = 0; openZoom = 0; wasOpening = false; starfield.forEach(s => { s.z = Math.random() * 400 + 50; }); };
      window.updateNebulaTheme = () => {
        blobs.forEach((b, i) => {
          b.hue = i < 3 ? randomWarmHue() : randomCoolHue();
        });
      };
    })();

    /* ── PARTICLES ── */
    (function () {
      const canvas = document.getElementById('particles');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth; canvas.height = window.innerHeight;
      window.addEventListener('resize', () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; });
      const particles = [];
      window.spawnParticles = function (x, y) {
        for (let i = 0; i < 28; i++) {
          const angle = Math.random() * Math.PI * 2, speed = 2 + Math.random() * 5;
          particles.push({ x, y, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed, life: 1, r: 2 + Math.random() * 3, hue: (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nebula-warm')) || 20) + Math.random() * 30 });
        }
      };
      (function loop() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx; p.y += p.vy; p.vx *= 0.92; p.vy *= 0.92; p.life -= 0.025;
          if (p.life <= 0) { particles.splice(i, 1); continue; }
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r * p.life, 0, Math.PI * 2);
          ctx.fillStyle = `hsla(${p.hue},90%,65%,${p.life})`; ctx.fill();
        }
        requestAnimationFrame(loop);
      })();
    })();

