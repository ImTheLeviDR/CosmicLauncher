    }
    .mod-tag.mc {
      color: var(--accent2);
      background: color-mix(in srgb, var(--accent2) 12%, transparent);
      border-color: color-mix(in srgb, var(--accent2) 28%, transparent);
      text-transform: none;
    }
    .mod-tag.loader {
      color: var(--text);
      background: rgba(255,255,255,0.06);
