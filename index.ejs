      flex-direction: column;
      position: relative;
      min-width: 0;
      min-height: 0;
    }

    .settings-body {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 40px 48px 48px;
    }

    .settings-body:has(#settingsTabModpacks.active),
    .settings-body:has(#settingsTabMods.active) {
      overflow: hidden;
    }

    .settings-tab-content#settingsTabModpacks.active,
    .settings-tab-content#settingsTabMods.active {
      height: 100%;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .settings-tab-content#settingsTabModpacks.active .modpacks-grid {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding-right: 4px;
    }

    .settings-tab-content#settingsTabModpacks.active .modpacks-grid::-webkit-scrollbar { width: 6px; }
    .settings-tab-content#settingsTabModpacks.active .modpacks-grid::-webkit-scrollbar-track { background: transparent; }
    .settings-tab-content#settingsTabModpacks.active .modpacks-grid::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }

    .settings-body::-webkit-scrollbar { width: 6px; }
    .settings-body::-webkit-scrollbar-track { background: transparent; }
    .settings-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }
    .settings-body::-webkit-scrollbar-thumb:hover { background: var(--accent); }

    .settings-tab-content { display: none; }
    .settings-tab-content.active { display: block; }

    @keyframes settingsItemIn {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .settings-tab-content.active .settings-section,
    .settings-tab-content.active .log-panel {
      animation: settingsItemIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      opacity: 0;
    }

    .mods-sub-tabs.animate-in,
    .mod-search-panel.animate-in,
    .mod-card.animate-in,
    .mods-empty.animate-in {
      animation: settingsItemIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      opacity: 0;
    }

    .settings-tab-content.active .settings-section:nth-child(1) { animation-delay: 0.04s; }
    .settings-tab-content.active .settings-section:nth-child(2) { animation-delay: 0.12s; }
    .settings-tab-content.active .settings-section:nth-child(3) { animation-delay: 0.20s; }
    .mods-sub-tabs.animate-in { animation-delay: 0.04s; }
    .mod-search-panel.animate-in { animation-delay: 0.10s; }
    .mod-card.animate-in { animation-delay: calc(0.08s + var(--stagger, 0) * 0.05s); }
    .mods-empty.animate-in { animation-delay: 0.12s; }
    .settings-tab-content.active .log-panel { animation-delay: 0.06s; }

