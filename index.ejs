    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    const markedLib = (() => {
      try {
        // marked v18+ is ESM-only ("type":"module"), so require() returns an empty module.
        // Load the UMD build by evaluating it with a CommonJS-style module shim.
        const fs = require('fs');
        const pathMod = require('path');
        const umdPath = pathMod.join(pathMod.dirname(require.resolve('marked/package.json')), 'lib', 'marked.umd.js');
        const code = fs.readFileSync(umdPath, 'utf8');
        const moduleShim = { exports: {} };
        const load = new Function('exports', 'module', 'require', `${code}\nreturn module.exports;`);
        return load(moduleShim.exports, moduleShim, require);
      } catch (err) {
        console.warn('marked not available:', err);
        return null;
      }
    })();

    const markedParse = (() => {
      if (!markedLib) return null;
      if (typeof markedLib.parse === 'function') return markedLib.parse.bind(markedLib);
      if (typeof markedLib.marked === 'function') return markedLib.marked.bind(markedLib);
      if (typeof markedLib === 'function') return markedLib;
      return null;
    })();

    if (markedLib?.setOptions) {
      markedLib.setOptions({
        gfm: true,
        breaks: false,
        pedantic: false,
