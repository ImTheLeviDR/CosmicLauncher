      { id: 'sunset', label: 'Sunset', bg: '#0f0608', accent: '#f472b6', accent2: '#fdba74' },
      { id: 'frost', label: 'Frost', bg: '#0a1018', accent: '#94a3b8', accent2: '#e2e8f0' },
