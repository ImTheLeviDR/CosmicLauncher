    /* ── PLAYER SKIN VIEWER ── */
    let playerSkinViewer = null;

    function setupSkinSpinPhysics(viewer, canvas) {
      const wrapper = viewer.playerWrapper;
      const controls = viewer.controls;
      controls.enabled = false;

      let dragging = false;
      let lastX = 0;
      let lastT = 0;
      let dragVelocity = 0;
      let spinVelocity = 0;
      let lastFrame = performance.now();

      const rotateSpeed = 0.9;
      const frictionPerFrame = 0.94;
      const minSpin = 0.00003;
      const maxReleaseSpeed = 0.01;

      function pxVelocityToRadPerMs(pxPerMs) {
        return pxPerMs * ((2 * Math.PI * rotateSpeed) / Math.max(canvas.clientHeight, 1));
      }

      function curveReleaseVelocity(radPerMs) {
        const sign = Math.sign(radPerMs) || 1;
        const abs = Math.abs(radPerMs);
        return sign * maxReleaseSpeed * Math.tanh(abs / maxReleaseSpeed);
      }

      function spinFriction(radPerMs, dtMs) {
        const speedRatio = Math.min(Math.abs(radPerMs) / maxReleaseSpeed, 1);
        const frameFriction = frictionPerFrame - speedRatio * 0.08;
        return Math.pow(frameFriction, dtMs / 16.667);
      }

      function applyDragDelta(dx) {
        wrapper.rotation.y += (2 * Math.PI * rotateSpeed * dx) / Math.max(canvas.clientHeight, 1);
      }

      function onPointerDown(e) {
        if (e.button !== 0) return;
        dragging = true;
        lastX = e.clientX;
        lastT = performance.now();
        dragVelocity = 0;
        spinVelocity = 0;
        canvas.setPointerCapture(e.pointerId);
        canvas.style.cursor = 'grabbing';
      }

      function onPointerMove(e) {
        if (!dragging) return;
        const now = performance.now();
        const dt = Math.max(now - lastT, 1);
        const dx = e.clientX - lastX;
        applyDragDelta(dx);
        dragVelocity = dragVelocity * 0.4 + (dx / dt) * 0.6;
        lastX = e.clientX;
        lastT = now;
      }

      function onPointerUp(e) {
        if (!dragging) return;
        dragging = false;
        spinVelocity = curveReleaseVelocity(pxVelocityToRadPerMs(dragVelocity));
        try { canvas.releasePointerCapture(e.pointerId); } catch (_) {}
        canvas.style.cursor = 'grab';
      }

      canvas.addEventListener('pointerdown', onPointerDown);
      canvas.addEventListener('pointermove', onPointerMove);
      canvas.addEventListener('pointerup', onPointerUp);
      canvas.addEventListener('pointercancel', onPointerUp);

      (function spinLoop(now) {
        const dtMs = Math.min(Math.max(now - lastFrame, 1), 50);
        lastFrame = now;

        if (!dragging && Math.abs(spinVelocity) > minSpin) {
          wrapper.rotation.y += spinVelocity * dtMs;
          spinVelocity *= spinFriction(spinVelocity, dtMs);
        }

        requestAnimationFrame(spinLoop);
      })(performance.now());
    }

    const STEVE_SKIN_URL = 'https://mc-heads.net/skin/Steve';
    let avatarCacheBust = Date.now();

    function normalizeSkinUrl(url) {
      return (url || '').replace(/^http:\/\//i, 'https://');
    }

    function getPlayerAvatarSources(uuid, username) {
      const name = (username || 'Steve').trim() || 'Steve';
      const id = (uuid || '').replace(/-/g, '');
      const bust = avatarCacheBust;
      const sources = [
        `https://mc-heads.net/avatar/${encodeURIComponent(name)}/64?cb=${bust}`,
      ];
      if (id) {
        sources.push(`https://minotar.net/avatar/${id}/64?cb=${bust}`);
        sources.push(`https://mc-heads.net/avatar/${uuid}/64?cb=${bust}`);
        sources.push(`https://mc-heads.net/avatar/${id}/64?cb=${bust}`);
      }
      sources.push(`https://mc-heads.net/avatar/Steve/64?cb=${bust}`);
      return sources;
    }

    function setProfileAvatarImg(imgEl, uuid, username, bust = false) {
      if (!imgEl) return;
      if (bust) avatarCacheBust = Date.now();
      const sources = getPlayerAvatarSources(uuid, username);
      let index = 0;

      const tryNext = () => {
        if (index >= sources.length) return;
        imgEl.onerror = () => {
          index += 1;
          tryNext();
        };
        imgEl.onload = () => {
          imgEl.onerror = null;
          if (selectedTheme === 'auto' && imgEl.id === 'activeProfileImg') {
            refreshAutoTheme();
          }
        };
        imgEl.src = sources[index];
      };

      tryNext();
    }

    function initProfileAvatarImages() {
      document.querySelectorAll('.profile-head-img[data-name]').forEach((img) => {
        setProfileAvatarImg(img, img.dataset.uuid || null, img.dataset.name);
      });
    }

    async function fetchMojangSkinProfile(uuid) {
      const id = (uuid || '').replace(/-/g, '');
      if (!id) return null;

      const res = await fetch(`https://sessionserver.mojang.com/session/minecraft/profile/${id}?unsigned=false`);
      if (!res.ok) return null;

      const data = await res.json();
      const textureProp = data.properties?.find((p) => p.name === 'textures');
      if (!textureProp?.value) return null;

      const payload = JSON.parse(atob(textureProp.value));
      const skin = payload?.textures?.SKIN;
      if (!skin?.url) return null;

      return {
        url: normalizeSkinUrl(skin.url),
        model: skin.metadata?.model === 'slim' ? 'slim' : 'default',
      };
    }

    function getPlayerSkinCandidates(uuid, username) {
      const name = (username || 'Steve').trim() || 'Steve';
      const id = (uuid || '').replace(/-/g, '');
      const candidates = [];

      if (id) candidates.push({ source: 'mojang', uuid: id });
      candidates.push({ url: `https://mc-heads.net/skin/${encodeURIComponent(name)}`, model: 'auto-detect' });
      if (id) {
        candidates.push({ url: `https://minotar.net/skin/${id}`, model: 'auto-detect' });
        candidates.push({ url: `https://mc-heads.net/skin/${uuid}`, model: 'auto-detect' });
        candidates.push({ url: `https://mc-heads.net/skin/${id}`, model: 'auto-detect' });
      }
      candidates.push({ url: STEVE_SKIN_URL, model: 'default' });
      return candidates;
    }

    async function resolvePlayerSkin(uuid, username) {
      const candidates = getPlayerSkinCandidates(uuid, username);

      for (const candidate of candidates) {
        if (candidate.source === 'mojang') {
          try {
            const profile = await fetchMojangSkinProfile(candidate.uuid);
            if (profile) return profile;
          } catch (_) {}
          continue;
        }

        return candidate;
      }

      return { url: STEVE_SKIN_URL, model: 'default' };
    }

    async function applyPlayerSkin(uuid, username) {
      if (!playerSkinViewer) return;
      const candidates = getPlayerSkinCandidates(uuid, username);

      for (const candidate of candidates) {
        try {
          if (candidate.source === 'mojang') {
            const profile = await fetchMojangSkinProfile(candidate.uuid);
            if (!profile) continue;
            await playerSkinViewer.loadSkin(profile.url, { model: profile.model });
            refreshAutoTheme();
            return;
          }

          await playerSkinViewer.loadSkin(candidate.url, { model: candidate.model });
          refreshAutoTheme();
          return;
        } catch (_) {}
      }

      await playerSkinViewer.loadSkin(STEVE_SKIN_URL, { model: 'default' });
      refreshAutoTheme();
    }

    function updatePlayerSkin(uuid, username) {
      return applyPlayerSkin(uuid, username);
    }

    function getPlayerModelSize() {
      const panel = document.getElementById('playerModelPanel');
      if (!panel) return { w: 282, h: 370 };
      const w = Math.min(Math.max(panel.clientWidth - 16, 194), 334);
      const h = Math.min(Math.max(window.innerHeight - 120, 246), 458);
      return { w, h };
    }

    async function initPlayerModel() {
      if (typeof skinview3d === 'undefined') return;
      const canvas = document.getElementById('playerSkinCanvas');
      if (!canvas) return;

      const activeNameEl = document.getElementById('activeProfileName');
      const initialName = activeNameEl ? activeNameEl.textContent.trim() : 'Steve';
      const initialUuid = activeNameEl?.dataset.uuid || null;
      const { w, h } = getPlayerModelSize();

      playerSkinViewer = new skinview3d.SkinViewer({
        canvas,
        width: w,
        height: h,
        skin: STEVE_SKIN_URL,
        model: 'auto-detect',
        enableControls: true,
      });

      playerSkinViewer.background = null;
      playerSkinViewer.fov = 42;
      playerSkinViewer.zoom = 0.79;
      playerSkinViewer.globalLight.intensity = 3.2;
      playerSkinViewer.cameraLight.intensity = 0.55;
      playerSkinViewer.animation = new skinview3d.WalkingAnimation();
      playerSkinViewer.animation.speed = 0.55;

      const controls = playerSkinViewer.controls;
      controls.enableZoom = false;
      controls.enablePan = false;
      setupSkinSpinPhysics(playerSkinViewer, canvas);

      if (initialName !== 'Account' && initialName !== 'Select Account') {
        await applyPlayerSkin(initialUuid, initialName);
      } else {
        await applyPlayerSkin(null, 'Steve');
      }

      window.addEventListener('resize', () => {
        if (!playerSkinViewer) return;
        const size = getPlayerModelSize();
        playerSkinViewer.width = size.w;
        playerSkinViewer.height = size.h;
      });
    }

    async function runStartup() {
      const STARTUP_TIMEOUT_MS = 12000;

      try {
        await Promise.race([
          (async () => {
            await initPlayerModel();
            initProfileAvatarImages();
          })(),
          new Promise((resolve) => setTimeout(resolve, STARTUP_TIMEOUT_MS)),
        ]);
      } catch (err) {
        console.error('Startup skin load failed:', err);
      } finally {
        document.body.classList.remove('booting');
        document.body.classList.add('app-ready');
        if (window.ipcRenderer) {
          window.ipcRenderer.send('startup-ready');
        } else if (window.triggerOpenAnimation) {
          window.triggerOpenAnimation();
        }
        setTimeout(() => {
          if (!document.body.classList.contains('needs-onboarding')) {
            checkLauncherUpdates(false);
          }
        }, 900);
      }
    }

    const MOD_FALLBACK_ICON = 'data:image/svg+xml,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect fill="#6b6860" width="32" height="32"/><text x="16" y="22" text-anchor="middle" font-size="18" fill="#f0ece4">?</text></svg>'
    );

    function isSvgIconUrl(url) {
      if (!url) return false;
      const lower = url.toLowerCase();
      if (lower.includes('image/svg+xml')) return true;
      try {
        return new URL(url, window.location.href).pathname.toLowerCase().endsWith('.svg');
      } catch {
        return lower.includes('.svg');
      }
    }

    function revokeModIconBlob(imgEl) {
      if (imgEl && imgEl._modIconBlob) {
        URL.revokeObjectURL(imgEl._modIconBlob);
        imgEl._modIconBlob = null;
      }
    }

    function applyModIconFallback(imgEl) {
      revokeModIconBlob(imgEl);
      imgEl.onerror = null;
      imgEl.src = MOD_FALLBACK_ICON;
    }

    async function loadModIconViaFetch(imgEl, iconUrl) {
      try {
        const res = await fetch(iconUrl);
        if (!res.ok) throw new Error('icon fetch failed');
        const blob = await res.blob();
        const blobUrl = URL.createObjectURL(blob);
        imgEl._modIconBlob = blobUrl;
        imgEl.onerror = () => applyModIconFallback(imgEl);
        imgEl.onload = () => { imgEl.onerror = null; };
        imgEl.src = blobUrl;
      } catch {
        applyModIconFallback(imgEl);
      }
    }

    async function setModIconImg(imgEl, iconUrl) {
      if (!imgEl) return;
      revokeModIconBlob(imgEl);

      if (!iconUrl) {
        applyModIconFallback(imgEl);
        return;
      }

      if (isSvgIconUrl(iconUrl)) {
        imgEl.src = MOD_FALLBACK_ICON;
        await loadModIconViaFetch(imgEl, iconUrl);
        return;
      }

      imgEl.onerror = () => {
        imgEl.onerror = null;
        loadModIconViaFetch(imgEl, iconUrl);
      };
      imgEl.onload = () => { imgEl.onerror = null; };
      imgEl.src = iconUrl;
    }

    function modIconTag(iconUrl) {
      return `<img class="mod-icon" alt="" data-mod-icon="${encodeURIComponent(iconUrl || '')}">`;
