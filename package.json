{
  "name": "cosmic-launcher",
  "version": "0.1.8",
  "description": "Cosmic Launcher - A beautiful Minecraft launcher",
  "author": "ImTheLeviDR",
  "homepage": "https://github.com/ImTheLeviDR/CosmicLauncher",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImTheLeviDR/CosmicLauncher.git"
  },
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "node scripts/build.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "node scripts/build.js --linux"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "fs-extra": "^11.3.0",
    "helios-core": "^2.3.0",
    "marked": "^18.0.9",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.cosmic.launcher",
    "productName": "Cosmic Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.ejs",
      "app/**/*",
      "sounds/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "app/assets/logo.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "app/assets/logo.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/assets/icons",
      "category": "Game",
      "synopsis": "A Minecraft launcher",
      "maintainer": "ImTheLeviDR",
      "executableName": "cosmic-launcher",
      "artifactName": "Cosmic.Launcher-${version}-${arch}.${ext}",
      "desktop": {
        "Name": "Cosmic Launcher",
        "Comment": "A Minecraft launcher",
        "StartupWMClass": "cosmic-launcher"
      }
    },
    "deb": {
      "priority": "optional"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Cosmic.Launcher.Setup.${version}.${ext}"
    }
  }
}
